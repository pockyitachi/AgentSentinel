{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsentinel.local/schemas/r2_2/policy_receipt.v1.schema.json",
  "title": "R2.2 Sentinel Policy Hash-Only Receipt v1",
  "description": "Closed provenance receipt for one SHADOW-only policy evaluation. The accepted checkpoint uses CPU/offline/fake transport; the separately authorized OpenAI transport pair is reserved for R2.4. The receipt stores hashes, bounded metadata, validation, census, and latency but no evidence, screenshot, provider output, request view, or reasoning content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "logical_call_id",
    "host_id",
    "packet_id",
    "policy_id",
    "execution_scope",
    "mode",
    "requested_model",
    "returned_model",
    "api_method",
    "openai_sdk_version",
    "reasoning_effort",
    "sdk_max_retries",
    "transport_kind",
    "transport_authority",
    "prompt_sha256",
    "output_schema_sha256",
    "request_config_sha256",
    "evidence_packet_sha256",
    "current_image_sha256",
    "response_id",
    "response_status",
    "service_tier",
    "response_envelope_sha256",
    "provider_output_sha256",
    "parsed_proposal_sha256",
    "admitted_plan_sha256",
    "evaluation_status",
    "failure_code",
    "validation_checks",
    "input_tokens",
    "output_tokens",
    "total_tokens",
    "transport_calls",
    "packet_build_latency_ns",
    "transport_latency_ns",
    "parse_latency_ns",
    "admission_latency_ns",
    "total_latency_ns",
    "target_count",
    "decision_count",
    "keep_count",
    "drop_count",
    "replace_count",
    "keep_uncertain_count",
    "material_decision_count",
    "abstain_decision_count",
    "external_network_attempted",
    "model_call_attempted",
    "local_gpu_used",
    "mobileworld_action_executed",
    "evidence_persisted",
    "screenshot_persisted",
    "provider_output_persisted",
    "reasoning_persisted"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "mobileworld.runtime.sentinel-policy-receipt/v1"
    },
    "logical_call_id": {"$ref": "#/$defs/runtimeId"},
    "host_id": {"$ref": "#/$defs/runtimeId"},
    "packet_id": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/runtimeId"}
      ]
    },
    "policy_id": {"$ref": "#/$defs/semanticId"},
    "execution_scope": {
      "type": "string",
      "const": "SHADOW_ONLY"
    },
    "mode": {
      "type": "string",
      "const": "SHADOW"
    },
    "requested_model": {
      "type": "string",
      "const": "gpt-5.6-sol"
    },
    "returned_model": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "const": "gpt-5.6-sol"}
      ]
    },
    "api_method": {
      "type": "string",
      "const": "responses.create"
    },
    "openai_sdk_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$"
    },
    "reasoning_effort": {
      "type": "string",
      "const": "medium"
    },
    "sdk_max_retries": {
      "type": "integer",
      "const": 0
    },
    "transport_kind": {
      "type": "string",
      "enum": ["FAKE", "OPENAI_RESPONSES"]
    },
    "transport_authority": {
      "type": "string",
      "enum": ["CPU_OFFLINE_FAKE", "EXPLICIT_OWNER_AUTHORIZATION"]
    },
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "output_schema_sha256": {"$ref": "#/$defs/sha256"},
    "request_config_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_packet_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "current_image_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "response_id": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/semanticId"}
      ]
    },
    "response_status": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "const": "completed"}
      ]
    },
    "service_tier": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/semanticId"}
      ]
    },
    "response_envelope_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "provider_output_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "parsed_proposal_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "admitted_plan_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "evaluation_status": {
      "type": "string",
      "enum": [
        "ADMITTED",
        "EVIDENCE_REJECTED",
        "TRANSPORT_ERROR",
        "INVALID_RESPONSE",
        "ADMISSION_REJECTED",
        "INTERNAL_ERROR"
      ]
    },
    "failure_code": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      ]
    },
    "validation_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "input_tokens": {"$ref": "#/$defs/optionalCount"},
    "output_tokens": {"$ref": "#/$defs/optionalCount"},
    "total_tokens": {"$ref": "#/$defs/optionalCount"},
    "transport_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "packet_build_latency_ns": {"$ref": "#/$defs/latency"},
    "transport_latency_ns": {"$ref": "#/$defs/latency"},
    "parse_latency_ns": {"$ref": "#/$defs/latency"},
    "admission_latency_ns": {"$ref": "#/$defs/latency"},
    "total_latency_ns": {"$ref": "#/$defs/latency"},
    "target_count": {"$ref": "#/$defs/censusCount"},
    "decision_count": {"$ref": "#/$defs/censusCount"},
    "keep_count": {"$ref": "#/$defs/censusCount"},
    "drop_count": {"$ref": "#/$defs/censusCount"},
    "replace_count": {"$ref": "#/$defs/censusCount"},
    "keep_uncertain_count": {"$ref": "#/$defs/censusCount"},
    "material_decision_count": {"$ref": "#/$defs/censusCount"},
    "abstain_decision_count": {"$ref": "#/$defs/censusCount"},
    "external_network_attempted": {"type": "boolean"},
    "model_call_attempted": {"type": "boolean"},
    "local_gpu_used": {"type": "boolean", "const": false},
    "mobileworld_action_executed": {"type": "boolean", "const": false},
    "evidence_persisted": {"type": "boolean", "const": false},
    "screenshot_persisted": {"type": "boolean", "const": false},
    "provider_output_persisted": {"type": "boolean", "const": false},
    "reasoning_persisted": {"type": "boolean", "const": false}
  },
  "allOf": [
    {
      "if": {
        "properties": {"transport_kind": {"const": "FAKE"}},
        "required": ["transport_kind"]
      },
      "then": {
        "properties": {
          "transport_authority": {"const": "CPU_OFFLINE_FAKE"},
          "external_network_attempted": {"const": false},
          "model_call_attempted": {"const": false}
        }
      },
      "else": {
        "properties": {
          "transport_authority": {"const": "EXPLICIT_OWNER_AUTHORIZATION"}
        }
      }
    },
    {
      "if": {
        "properties": {"packet_id": {"type": "null"}},
        "required": ["packet_id"]
      },
      "then": {
        "properties": {
          "evidence_packet_sha256": {"type": "null"},
          "current_image_sha256": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "evidence_packet_sha256": {"$ref": "#/$defs/sha256"},
          "current_image_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    {
      "if": {
        "properties": {"response_envelope_sha256": {"type": "null"}},
        "required": ["response_envelope_sha256"]
      },
      "then": {
        "properties": {
          "returned_model": {"type": "null"},
          "response_id": {"type": "null"},
          "response_status": {"type": "null"},
          "service_tier": {"type": "null"},
          "provider_output_sha256": {"type": "null"},
          "parsed_proposal_sha256": {"type": "null"},
          "admitted_plan_sha256": {"type": "null"},
          "input_tokens": {"type": "null"},
          "output_tokens": {"type": "null"},
          "total_tokens": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "returned_model": {"type": "string", "const": "gpt-5.6-sol"},
          "response_id": {"$ref": "#/$defs/semanticId"},
          "response_status": {"type": "string", "const": "completed"},
          "provider_output_sha256": {"$ref": "#/$defs/sha256"},
          "transport_calls": {"const": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"parsed_proposal_sha256": {"type": "null"}},
        "required": ["parsed_proposal_sha256"]
      },
      "then": {
        "properties": {"admitted_plan_sha256": {"type": "null"}}
      },
      "else": {
        "properties": {
          "response_envelope_sha256": {"$ref": "#/$defs/sha256"},
          "provider_output_sha256": {"$ref": "#/$defs/sha256"},
          "transport_calls": {"const": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"evaluation_status": {"const": "ADMITTED"}},
        "required": ["evaluation_status"]
      },
      "then": {
        "properties": {
          "packet_id": {"$ref": "#/$defs/runtimeId"},
          "evidence_packet_sha256": {"$ref": "#/$defs/sha256"},
          "current_image_sha256": {"$ref": "#/$defs/sha256"},
          "returned_model": {"type": "string", "const": "gpt-5.6-sol"},
          "response_id": {"$ref": "#/$defs/semanticId"},
          "response_status": {"type": "string", "const": "completed"},
          "response_envelope_sha256": {"$ref": "#/$defs/sha256"},
          "provider_output_sha256": {"$ref": "#/$defs/sha256"},
          "parsed_proposal_sha256": {"$ref": "#/$defs/sha256"},
          "admitted_plan_sha256": {"$ref": "#/$defs/sha256"},
          "failure_code": {"type": "null"},
          "transport_calls": {"const": 1}
        }
      },
      "else": {
        "properties": {
          "failure_code": {"type": "string"},
          "admitted_plan_sha256": {"type": "null"},
          "decision_count": {"const": 0},
          "keep_count": {"const": 0},
          "drop_count": {"const": 0},
          "replace_count": {"const": 0},
          "keep_uncertain_count": {"const": 0},
          "material_decision_count": {"const": 0},
          "abstain_decision_count": {"const": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"evaluation_status": {"const": "EVIDENCE_REJECTED"}},
        "required": ["evaluation_status"]
      },
      "then": {
        "properties": {
          "packet_id": {"type": "null"},
          "transport_calls": {"const": 0},
          "transport_latency_ns": {"const": 0},
          "parse_latency_ns": {"const": 0},
          "admission_latency_ns": {"const": 0},
          "target_count": {"const": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"evaluation_status": {"const": "TRANSPORT_ERROR"}},
        "required": ["evaluation_status"]
      },
      "then": {
        "properties": {
          "packet_id": {"$ref": "#/$defs/runtimeId"},
          "response_envelope_sha256": {"type": "null"},
          "transport_calls": {"const": 1},
          "parse_latency_ns": {"const": 0},
          "admission_latency_ns": {"const": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"evaluation_status": {"const": "INVALID_RESPONSE"}},
        "required": ["evaluation_status"]
      },
      "then": {
        "properties": {
          "packet_id": {"$ref": "#/$defs/runtimeId"},
          "response_envelope_sha256": {"$ref": "#/$defs/sha256"},
          "parsed_proposal_sha256": {"type": "null"},
          "transport_calls": {"const": 1},
          "admission_latency_ns": {"const": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"evaluation_status": {"const": "ADMISSION_REJECTED"}},
        "required": ["evaluation_status"]
      },
      "then": {
        "properties": {
          "packet_id": {"$ref": "#/$defs/runtimeId"},
          "response_envelope_sha256": {"$ref": "#/$defs/sha256"},
          "parsed_proposal_sha256": {"$ref": "#/$defs/sha256"},
          "admitted_plan_sha256": {"type": "null"},
          "transport_calls": {"const": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"transport_calls": {"const": 0}},
        "required": ["transport_calls"]
      },
      "then": {
        "properties": {
          "returned_model": {"type": "null"},
          "response_id": {"type": "null"},
          "response_status": {"type": "null"},
          "service_tier": {"type": "null"},
          "response_envelope_sha256": {"type": "null"},
          "provider_output_sha256": {"type": "null"},
          "parsed_proposal_sha256": {"type": "null"},
          "admitted_plan_sha256": {"type": "null"},
          "input_tokens": {"type": "null"},
          "output_tokens": {"type": "null"},
          "total_tokens": {"type": "null"},
          "transport_latency_ns": {"const": 0},
          "external_network_attempted": {"const": false},
          "model_call_attempted": {"const": false}
        }
      },
      "else": {
        "properties": {
          "packet_id": {"$ref": "#/$defs/runtimeId"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "transport_kind": {"const": "OPENAI_RESPONSES"},
          "transport_calls": {"const": 1}
        },
        "required": ["transport_kind", "transport_calls"]
      },
      "then": {
        "properties": {
          "external_network_attempted": {"const": true},
          "model_call_attempted": {"const": true}
        }
      },
      "else": {
        "if": {
          "properties": {"transport_calls": {"const": 0}},
          "required": ["transport_calls"]
        },
        "then": {
          "properties": {
            "external_network_attempted": {"const": false},
            "model_call_attempted": {"const": false}
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "input_tokens": {"type": "null"},
            "output_tokens": {"type": "null"},
            "total_tokens": {"type": "null"}
          }
        },
        {
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0},
            "total_tokens": {"type": "integer", "minimum": 0}
          }
        }
      ]
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtimeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "semanticId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "optionalCount": {
      "oneOf": [
        {"type": "null"},
        {"type": "integer", "minimum": 0}
      ]
    },
    "latency": {
      "type": "integer",
      "minimum": 0
    },
    "censusCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    }
  }
}
