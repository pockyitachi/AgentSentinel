{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsentinel.local/schemas/r2_2/policy_proposal.v1.schema.json",
  "title": "R2.2 Untrusted Runtime Policy Proposal v1",
  "description": "Closed structured output proposed by an untrusted semantic backend. It is automatic, non-curated, deployment-time prediction data and cannot authorize rendering by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "evidence_packet_sha256",
    "status",
    "automatic",
    "curated",
    "deployment_prediction",
    "action_or_tool_authority",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "mobileworld.runtime.sentinel-policy-proposal/v1"
    },
    "packet_id": {"$ref": "#/$defs/runtimeId"},
    "evidence_packet_sha256": {"$ref": "#/$defs/sha256"},
    "status": {
      "type": "string",
      "enum": ["COMPLETE", "PARTIAL_ABSTAIN", "ABSTAIN"]
    },
    "automatic": {"type": "boolean", "const": true},
    "curated": {"type": "boolean", "const": false},
    "deployment_prediction": {"type": "boolean", "const": true},
    "action_or_tool_authority": {"type": "boolean", "const": false},
    "decisions": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/decision"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "COMPLETE"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "decisions": {
            "not": {
              "contains": {
                "properties": {
                  "proposed_operation": {"const": "KEEP_UNCERTAIN"}
                },
                "required": ["proposed_operation"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "PARTIAL_ABSTAIN"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "decisions": {
            "minItems": 2,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "proposed_operation": {"const": "KEEP_UNCERTAIN"}
                  },
                  "required": ["proposed_operation"]
                },
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "proposed_operation": {
                      "enum": ["KEEP", "DROP", "REPLACE"]
                    }
                  },
                  "required": ["proposed_operation"]
                },
                "minContains": 1
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "ABSTAIN"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "decisions": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/decision"},
                {
                  "properties": {
                    "proposed_operation": {"const": "KEEP_UNCERTAIN"},
                    "fallback_status": {"const": "ABSTAIN_TO_ORIGINAL"}
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtimeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "semanticId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "payload_sha256", "relation"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/semanticId"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "relation": {
          "type": "string",
          "enum": ["SUPPORTS", "REFUTES", "INVALIDATES"]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "target_id",
        "factual_verdict",
        "temporal_validity",
        "proposed_operation",
        "evidence_refs",
        "confidence_millis",
        "reason_code",
        "uncertainty_codes",
        "rationale_summary",
        "replacement_fact_id",
        "fallback_status"
      ],
      "properties": {
        "decision_id": {"$ref": "#/$defs/semanticId"},
        "target_id": {"$ref": "#/$defs/semanticId"},
        "factual_verdict": {
          "type": "string",
          "enum": ["SUPPORTED", "REFUTED", "UNVERIFIABLE"]
        },
        "temporal_validity": {
          "type": "string",
          "enum": ["ACTIVE", "INVALIDATED", "UNKNOWN", "N_A"]
        },
        "proposed_operation": {
          "type": "string",
          "enum": ["KEEP", "DROP", "REPLACE", "KEEP_UNCERTAIN"]
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceRef"}
        },
        "confidence_millis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "DIRECT_EVIDENCE_SUPPORT",
            "DIRECT_EVIDENCE_REFUTATION",
            "LATER_EVIDENCE_INVALIDATES",
            "INSUFFICIENT_EVIDENCE",
            "CONFLICTING_EVIDENCE",
            "TEMPORAL_PROVENANCE_MISSING",
            "TARGET_AMBIGUOUS",
            "CURRENT_SCREEN_ABSENCE_ONLY",
            "EXECUTOR_STATUS_ONLY",
            "CLEAN_HISTORY"
          ]
        },
        "uncertainty_codes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "EVIDENCE_MISSING",
              "EVIDENCE_CONFLICT",
              "TEMPORAL_PROVENANCE_MISSING",
              "TARGET_AMBIGUOUS",
              "COMPOUND_CLAIM",
              "CURRENT_SCREEN_ABSENCE_ONLY",
              "EXECUTOR_STATUS_ONLY",
              "SEMANTIC_ENTAILMENT_UNCERTAIN"
            ]
          }
        },
        "rationale_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\r\\n]+$"
        },
        "replacement_fact_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/semanticId"}
          ]
        },
        "fallback_status": {
          "type": "string",
          "enum": ["NONE", "ABSTAIN_TO_ORIGINAL"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"proposed_operation": {"const": "REPLACE"}},
            "required": ["proposed_operation"]
          },
          "then": {
            "properties": {
              "replacement_fact_id": {"$ref": "#/$defs/semanticId"}
            }
          },
          "else": {
            "properties": {"replacement_fact_id": {"type": "null"}}
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "factual_verdict": {"const": "UNVERIFIABLE"}
                },
                "required": ["factual_verdict"]
              },
              {
                "properties": {
                  "temporal_validity": {"const": "UNKNOWN"}
                },
                "required": ["temporal_validity"]
              }
            ]
          },
          "then": {
            "properties": {
              "proposed_operation": {"const": "KEEP_UNCERTAIN"},
              "uncertainty_codes": {"minItems": 1},
              "fallback_status": {"const": "ABSTAIN_TO_ORIGINAL"}
            }
          },
          "else": {
            "properties": {
              "proposed_operation": {"not": {"const": "KEEP_UNCERTAIN"}}
            }
          }
        },
        {
          "if": {
            "properties": {
              "proposed_operation": {"const": "KEEP"}
            },
            "required": ["proposed_operation"]
          },
          "then": {
            "properties": {
              "factual_verdict": {"const": "SUPPORTED"},
              "temporal_validity": {"enum": ["ACTIVE", "N_A"]},
              "evidence_refs": {
                "contains": {
                  "properties": {"relation": {"const": "SUPPORTS"}},
                  "required": ["relation"]
                },
                "minContains": 1
              },
              "reason_code": {"const": "DIRECT_EVIDENCE_SUPPORT"},
              "uncertainty_codes": {"maxItems": 0},
              "fallback_status": {"const": "NONE"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "proposed_operation": {"enum": ["DROP", "REPLACE"]}
            },
            "required": ["proposed_operation"]
          },
          "then": {
            "properties": {
              "evidence_refs": {"minItems": 1},
              "uncertainty_codes": {"maxItems": 0},
              "fallback_status": {"const": "NONE"}
            },
            "anyOf": [
              {
                "properties": {
                  "factual_verdict": {"const": "REFUTED"}
                },
                "required": ["factual_verdict"]
              },
              {
                "properties": {
                  "factual_verdict": {"const": "SUPPORTED"},
                  "temporal_validity": {"const": "INVALIDATED"}
                },
                "required": ["factual_verdict", "temporal_validity"]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "factual_verdict": {"const": "REFUTED"},
              "proposed_operation": {"enum": ["DROP", "REPLACE"]}
            },
            "required": ["factual_verdict", "proposed_operation"]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "contains": {
                  "properties": {"relation": {"const": "REFUTES"}},
                  "required": ["relation"]
                },
                "minContains": 1
              },
              "reason_code": {"const": "DIRECT_EVIDENCE_REFUTATION"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "factual_verdict": {"const": "SUPPORTED"},
              "temporal_validity": {"const": "INVALIDATED"},
              "proposed_operation": {"enum": ["DROP", "REPLACE"]}
            },
            "required": [
              "factual_verdict",
              "temporal_validity",
              "proposed_operation"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "allOf": [
                  {
                    "contains": {
                      "properties": {"relation": {"const": "SUPPORTS"}},
                      "required": ["relation"]
                    },
                    "minContains": 1
                  },
                  {
                    "contains": {
                      "properties": {"relation": {"const": "INVALIDATES"}},
                      "required": ["relation"]
                    },
                    "minContains": 1
                  }
                ]
              },
              "reason_code": {"const": "LATER_EVIDENCE_INVALIDATES"}
            }
          }
        }
      ]
    }
  }
}
