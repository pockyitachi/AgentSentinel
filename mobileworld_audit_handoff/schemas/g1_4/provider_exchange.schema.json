{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsentinel.local/schemas/g1_4/provider_exchange.schema.json",
  "title": "G1.4 provider request/response exchange receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "protocol_version", "exchange_id", "run_id", "provider_attempt_index", "provider_codec_id", "provider_contract_version", "endpoint_revision", "application_request_sha256", "final_application_request_sha256", "encoded_request_sha256", "model_parameters_sha256", "request_byte_count", "encoded_request_ref", "response_sha256", "response_byte_count", "raw_response_ref", "chunks", "latency_ms", "token_usage", "transport_status", "error_code", "retryable", "simulated", "external_provider_invoked", "gpu_used"],
  "properties": {
    "schema_version": {"const": "mobileworld.g1.replay-provider-exchange/v1"},
    "record_type": {"const": "g1_replay_provider_exchange"},
    "protocol_version": {"const": "mobileworld.g1.causal-replay/protocol-v1"},
    "exchange_id": {"type": "string", "pattern": "^g1exchange-[0-9a-f]{24}$"},
    "run_id": {"type": "string", "pattern": "^g1run-[0-9a-f]{24}$"},
    "provider_attempt_index": {"type": "integer", "minimum": 1, "maximum": 3},
    "provider_codec_id": {"const": "mobileworld.g1.provider.fake-conformance/v1"},
    "provider_contract_version": {"const": "v1"},
    "endpoint_revision": {"const": "fake://network-forbidden/v1"},
    "application_request_sha256": {"$ref": "#/$defs/sha256"},
    "final_application_request_sha256": {"$ref": "#/$defs/sha256"},
    "encoded_request_sha256": {"$ref": "#/$defs/sha256"},
    "model_parameters_sha256": {"$ref": "#/$defs/sha256"},
    "request_byte_count": {"type": "integer", "minimum": 2},
    "encoded_request_ref": {"$ref": "#/$defs/jsonArtifactRef"},
    "response_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "response_byte_count": {"type": ["integer", "null"], "minimum": 0},
    "raw_response_ref": {"oneOf": [{"$ref": "#/$defs/binaryArtifactRef"}, {"type": "null"}]},
    "chunks": {"type": "array", "items": {"$ref": "#/$defs/chunk"}},
    "latency_ms": {"type": ["integer", "null"], "minimum": 0},
    "token_usage": {"oneOf": [{"$ref": "#/$defs/tokenUsage"}, {"type": "null"}]},
    "transport_status": {"enum": ["RETURNED", "FAILED"]},
    "error_code": {"type": ["string", "null"]},
    "retryable": {"type": "boolean"},
    "simulated": {"const": true},
    "external_provider_invoked": {"const": false},
    "gpu_used": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"transport_status": {"const": "RETURNED"}}}, "then": {"properties": {"response_sha256": {"$ref": "#/$defs/sha256"}, "response_byte_count": {"type": "integer", "minimum": 0}, "raw_response_ref": {"$ref": "#/$defs/binaryArtifactRef"}, "latency_ms": {"type": "integer", "minimum": 0}, "token_usage": {"$ref": "#/$defs/tokenUsage"}, "error_code": {"type": "null"}, "retryable": {"const": false}}}, "else": {"properties": {"response_sha256": {"type": "null"}, "response_byte_count": {"type": "null"}, "raw_response_ref": {"type": "null"}, "chunks": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/chunk"}, {"properties": {"is_final": {"const": false}}}]}}, "latency_ms": {"type": "null"}, "token_usage": {"type": "null"}, "error_code": {"enum": ["TIMEOUT", "HTTP_5XX", "CONNECTION_ERROR"]}, "retryable": {"const": true}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "jsonArtifactRef": {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256", "byte_count", "media_type"], "properties": {"relative_path": {"type": "string", "pattern": "^objects/sha256/[0-9a-f]{2}/[0-9a-f]{64}$"}, "sha256": {"$ref": "#/$defs/sha256"}, "byte_count": {"type": "integer", "minimum": 2}, "media_type": {"const": "application/json"}}},
    "binaryArtifactRef": {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256", "byte_count", "media_type"], "properties": {"relative_path": {"type": "string", "pattern": "^objects/sha256/[0-9a-f]{2}/[0-9a-f]{64}$"}, "sha256": {"$ref": "#/$defs/sha256"}, "byte_count": {"type": "integer", "minimum": 0}, "media_type": {"const": "application/octet-stream"}}},
    "tokenUsage": {"type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens"], "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}}},
    "chunk": {"type": "object", "additionalProperties": false, "required": ["chunk_index", "byte_count", "sha256", "is_final", "content_ref"], "properties": {"chunk_index": {"type": "integer", "minimum": 0}, "byte_count": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}, "is_final": {"type": "boolean"}, "content_ref": {"$ref": "#/$defs/binaryArtifactRef"}}}
  }
}
