          },
          "argv": {
            "prefixItems": [
              {},
              {},
              {"pattern": "^/(?:[^/]+/)*models--Tongyi-MAI--MAI-UI-8B/snapshots/e00a0097abb9cc621cac5172d8c4809f0839c94e$"},
