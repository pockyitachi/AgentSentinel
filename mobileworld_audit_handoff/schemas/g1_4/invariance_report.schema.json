{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsentinel.local/schemas/g1_4/invariance_report.schema.json",
  "title": "G1.4 pre-invocation invariance report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "protocol_version", "report_id", "valid",
    "provider_invocation_allowed", "source_request_sha256", "rendered_request_sha256",
    "final_application_request_sha256", "encoded_request_sha256",
    "non_history_projection_sha256", "history_projection_sha256", "render_result_sha256",
    "validation_receipt_sha256", "target_diff_sha256", "requested_arm",
    "target_only_diff", "original_semantic_identity", "caller_input_immutable",
    "source_mapping_reversible", "roles_and_order_preserved", "tools_preserved",
    "current_observation_preserved", "model_and_sampling_preserved",
    "binary_artifacts_preserved", "checks", "errors"
  ],
  "properties": {
    "schema_version": {"const": "mobileworld.g1.replay-invariance-report/v1"},
    "record_type": {"const": "g1_replay_invariance_report"},
    "protocol_version": {"const": "mobileworld.g1.causal-replay/protocol-v1"},
    "report_id": {"type": "string", "pattern": "^g1invariance-[0-9a-f]{24}$"},
    "valid": {"const": true},
    "provider_invocation_allowed": {"const": false},
    "source_request_sha256": {"$ref": "#/$defs/sha256"},
    "rendered_request_sha256": {"$ref": "#/$defs/sha256"},
    "final_application_request_sha256": {"$ref": "#/$defs/sha256"},
    "encoded_request_sha256": {"$ref": "#/$defs/sha256"},
    "non_history_projection_sha256": {"$ref": "#/$defs/sha256"},
    "history_projection_sha256": {"$ref": "#/$defs/sha256"},
    "render_result_sha256": {"$ref": "#/$defs/sha256"},
    "validation_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "target_diff_sha256": {"$ref": "#/$defs/sha256"},
    "requested_arm": {"enum": ["ORIGINAL", "MASK", "MASK_CORRECTION", "ORACLE_CLEAN", "SHAM_BENIGN_EDIT"]},
    "target_only_diff": {"const": true},
    "original_semantic_identity": {"const": true},
    "caller_input_immutable": {"const": true},
    "source_mapping_reversible": {"const": true},
    "roles_and_order_preserved": {"const": true},
    "tools_preserved": {"const": true},
    "current_observation_preserved": {"const": true},
    "model_and_sampling_preserved": {"const": true},
    "binary_artifacts_preserved": {"const": true},
    "checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "errors": {"const": []}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
