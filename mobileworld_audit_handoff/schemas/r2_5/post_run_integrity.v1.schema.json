{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agentsentinel.local/schemas/r2_5/post_run_integrity.v1.schema.json",
  "title":"R2.5 post-run official Collector integrity acceptance",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "authority_manifest_sha256",
    "backend_endpoint",
    "checker_version",
    "cleanup_file",
    "collector_run_count",
    "pilot_collector_run_count",
    "pilot_collector_runs",
    "smoke_collector_run_count",
    "smoke_collector_runs",
    "factory_binding_sha256",
    "manifest_binding_file",
    "max_post_run_integrity_wall_time_seconds",
    "max_sequence_wall_time_seconds",
    "ordered_collector_integrity_root_sha256",
    "ordered_pilot_collector_integrity_root_sha256",
    "ordered_smoke_collector_integrity_root_sha256",
    "pilot_manifest",
    "pilot_manifest_sha256",
    "post_run_integrity_wall_time_ms",
    "preflight_report_sha256",
    "pricing_sha256",
    "production_audit_root_identity_sha256",
    "report_root_identity",
    "resolved_pilot_inputs_sha256",
    "run_id",
    "runtime_config_sha256",
    "schema_version",
    "sentinel_config_sha256",
    "sequence_output_root_identity",
    "source_commit",
    "stage_files",
    "status",
    "terminal_file",
    "total_sequence_wall_time_ms",
    "warnings_policy"
  ],
  "properties":{
    "authority_manifest_sha256":{"$ref":"#/$defs/sha256"},
    "backend_endpoint":{"type":"string","pattern":"^http://127\\.0\\.0\\.1:[1-9][0-9]{3,4}$"},
    "checker_version":{"const":"mobileworld.audit.integrity/v1"},
    "cleanup_file":{"$ref":"#/$defs/file"},
    "collector_run_count":{"type":"integer","minimum":86,"maximum":126},
    "pilot_collector_run_count":{"type":"integer","minimum":80,"maximum":120,"multipleOf":4},
    "pilot_collector_runs":{
      "type":"array",
      "minItems":80,
      "maxItems":120,
      "uniqueItems":true,
      "items":{"$ref":"#/$defs/collectorRun"}
    },
    "smoke_collector_run_count":{"const":6},
    "smoke_collector_runs":{
      "type":"array",
      "minItems":6,
      "maxItems":6,
      "uniqueItems":true,
      "items":{"$ref":"#/$defs/smokeCollectorRun"}
    },
    "factory_binding_sha256":{"$ref":"#/$defs/sha256"},
    "manifest_binding_file":{"$ref":"#/$defs/file"},
    "max_post_run_integrity_wall_time_seconds":{"type":"integer","minimum":1,"maximum":86400},
    "max_sequence_wall_time_seconds":{"type":"integer","minimum":1,"maximum":604800},
    "ordered_collector_integrity_root_sha256":{"$ref":"#/$defs/sha256"},
    "ordered_pilot_collector_integrity_root_sha256":{"$ref":"#/$defs/sha256"},
    "ordered_smoke_collector_integrity_root_sha256":{"$ref":"#/$defs/sha256"},
    "pilot_manifest":{"$ref":"#/$defs/pilotManifest"},
    "pilot_manifest_sha256":{"$ref":"#/$defs/sha256"},
    "post_run_integrity_wall_time_ms":{"type":"integer","minimum":0,"maximum":86400000},
    "preflight_report_sha256":{"$ref":"#/$defs/sha256"},
    "pricing_sha256":{"$ref":"#/$defs/sha256"},
    "production_audit_root_identity_sha256":{"oneOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},
    "report_root_identity":{"$ref":"#/$defs/directoryIdentity"},
    "resolved_pilot_inputs_sha256":{"$ref":"#/$defs/sha256"},
    "run_id":{"$ref":"#/$defs/safeId"},
    "runtime_config_sha256":{"$ref":"#/$defs/sha256"},
    "schema_version":{"const":"mobileworld.runtime.sentinel-r2.5-post-run-integrity/v1"},
    "sentinel_config_sha256":{"$ref":"#/$defs/sha256"},
    "sequence_output_root_identity":{"$ref":"#/$defs/directoryIdentity"},
    "source_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "stage_files":{
      "type":"array",
      "prefixItems":[
        {"allOf":[{"$ref":"#/$defs/stageFile"},{"properties":{"stage":{"const":"RESOURCE_PREFLIGHT"}}}]},
        {"allOf":[{"$ref":"#/$defs/stageFile"},{"properties":{"stage":{"const":"QWEN_LIVE_SMOKE"}}}]},
        {"allOf":[{"$ref":"#/$defs/stageFile"},{"properties":{"stage":{"const":"MAI_LIVE_SMOKE"}}}]},
        {"allOf":[{"$ref":"#/$defs/stageFile"},{"properties":{"stage":{"const":"R25_PILOT"}}}]}
      ],
      "items":false,
      "minItems":4,
      "maxItems":4
    },
    "status":{"const":"VALID"},
    "terminal_file":{"$ref":"#/$defs/file"},
    "total_sequence_wall_time_ms":{"type":"integer","minimum":0,"maximum":604800000},
    "warnings_policy":{"const":"REQUIRE_EMPTY"}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "safeId":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "absolutePath":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^/"},
    "directoryIdentity":{
      "type":"object",
      "additionalProperties":false,
      "required":["canonical_path","device","gid","identity_sha256","inode","kind","mode","uid"],
      "properties":{
        "canonical_path":{"$ref":"#/$defs/absolutePath"},
        "device":{"type":"integer","minimum":0},
        "gid":{"type":"integer","minimum":0},
        "identity_sha256":{"$ref":"#/$defs/sha256"},
        "inode":{"type":"integer","minimum":1},
        "kind":{"const":"DIRECTORY"},
        "mode":{"const":448},
        "uid":{"type":"integer","minimum":0}
      }
    },
    "fileIdentity":{
      "type":"object",
      "additionalProperties":false,
      "required":["canonical_path","device","gid","identity_sha256","inode","kind","mode","uid"],
      "properties":{
        "canonical_path":{"$ref":"#/$defs/absolutePath"},
        "device":{"type":"integer","minimum":0},
        "gid":{"type":"integer","minimum":0},
        "identity_sha256":{"$ref":"#/$defs/sha256"},
        "inode":{"type":"integer","minimum":1},
        "kind":{"const":"REGULAR_FILE"},
        "mode":{"const":384},
        "uid":{"type":"integer","minimum":0}
      }
    },
    "file":{
      "type":"object",
      "additionalProperties":false,
      "required":["byte_count","path_identity","sha256"],
      "properties":{
        "byte_count":{"type":"integer","minimum":1,"maximum":536870912},
        "path_identity":{"$ref":"#/$defs/fileIdentity"},
        "sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "stageFile":{
      "type":"object",
      "additionalProperties":false,
      "required":["byte_count","path_identity","sha256","stage"],
      "properties":{
        "byte_count":{"type":"integer","minimum":1,"maximum":536870912},
        "path_identity":{"$ref":"#/$defs/fileIdentity"},
        "sha256":{"$ref":"#/$defs/sha256"},
        "stage":{"enum":["RESOURCE_PREFLIGHT","QWEN_LIVE_SMOKE","MAI_LIVE_SMOKE","R25_PILOT"]}
      }
    },
    "manifest":{
      "type":"object",
      "additionalProperties":false,
      "required":["byte_count","path_identity","sha256"],
      "properties":{
        "byte_count":{"type":"integer","minimum":1,"maximum":67108864},
        "path_identity":{"$ref":"#/$defs/fileIdentity"},
        "sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "integrityReport":{
      "type":"object",
      "additionalProperties":false,
      "required":["byte_count","checker_version","error_count","path_identity","sha256","valid","warning_count"],
      "properties":{
        "byte_count":{"type":"integer","minimum":1,"maximum":16777216},
        "checker_version":{"const":"mobileworld.audit.integrity/v1"},
        "error_count":{"const":0},
        "path_identity":{"$ref":"#/$defs/fileIdentity"},
        "sha256":{"$ref":"#/$defs/sha256"},
        "valid":{"const":true},
        "warning_count":{"const":0}
      }
    },
    "pilotTask":{
      "type":"object",
      "additionalProperties":false,
      "required":["reset_seed","task_id","task_parameters_sha256"],
      "properties":{
        "reset_seed":{"type":"integer","minimum":0,"maximum":2147483647},
        "task_id":{"$ref":"#/$defs/safeId"},
        "task_parameters_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "pilotManifest":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "arms","baseline_mode","cohort_id","cohort_selection_artifact_byte_count",
        "cohort_selection_artifact_path","cohort_selection_artifact_sha256",
        "cohort_selection_sha256","dynamic_wall_clock_tasks_excluded",
        "environment_reset_between_cells","frozen_at_utc","hosts","joint_mode",
        "matched_task_ids","matched_task_parameters","max_steps_per_cell",
        "max_total_actor_calls","max_total_cost_usd_micros","max_total_openai_calls",
        "max_total_wall_time_seconds","official_success_metric_id",
        "official_success_operator","official_success_metric_required",
        "official_success_threshold_float_hex",
        "per_cell_timeout_seconds","schema_version","seed_policy",
        "task_manifest_byte_count","task_manifest_path","task_manifest_sha256",
        "task_time_authority","tasks","topology",
        "topology_comparison_artifact_byte_count","topology_comparison_artifact_path",
        "topology_comparison_artifact_sha256"
      ],
      "properties":{
        "arms":{"type":"array","prefixItems":[{"const":"BASELINE"},{"const":"JOINT_SENTINEL"}],"items":false},
        "baseline_mode":{"const":"OFF"},
        "cohort_id":{"$ref":"#/$defs/safeId"},
        "cohort_selection_artifact_byte_count":{"type":"integer","minimum":1,"maximum":8388608},
        "cohort_selection_artifact_path":{"$ref":"#/$defs/absolutePath"},
        "cohort_selection_artifact_sha256":{"$ref":"#/$defs/sha256"},
        "cohort_selection_sha256":{"$ref":"#/$defs/sha256"},
        "dynamic_wall_clock_tasks_excluded":{"const":true},
        "environment_reset_between_cells":{"const":true},
        "frozen_at_utc":{"type":"string","pattern":"^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "hosts":{"type":"array","prefixItems":[{"const":"QWEN3_VL"},{"const":"MAI_UI"}],"items":false},
        "joint_mode":{"const":"ACTIVE"},
        "matched_task_ids":{"const":true},
        "matched_task_parameters":{"const":true},
        "max_steps_per_cell":{"type":"integer","minimum":1,"maximum":8},
        "max_total_actor_calls":{"type":"integer","minimum":1,"maximum":1000000},
        "max_total_cost_usd_micros":{"type":"integer","minimum":1,"maximum":100000000000},
        "max_total_openai_calls":{"type":"integer","minimum":1,"maximum":2000000},
        "max_total_wall_time_seconds":{"type":"integer","minimum":1,"maximum":604800},
        "official_success_metric_required":{"const":true},
        "official_success_metric_id":{"const":"mobileworld.core.eval-score-gt/v1"},
        "official_success_operator":{"const":"GT"},
        "official_success_threshold_float_hex":{"const":"0x1.fae147ae147aep-1"},
        "per_cell_timeout_seconds":{"type":"integer","minimum":1,"maximum":14400},
        "schema_version":{"const":"mobileworld.runtime.sentinel-r2.5-frozen-pilot/v2"},
        "seed_policy":{"const":"FIXED_PER_TASK_SHARED_ACROSS_HOSTS_AND_ARMS"},
        "task_manifest_byte_count":{"type":"integer","minimum":1,"maximum":100000000},
        "task_manifest_path":{"$ref":"#/$defs/absolutePath"},
        "task_manifest_sha256":{"$ref":"#/$defs/sha256"},
        "task_time_authority":{"const":"STATIC_WALL_CLOCK_INDEPENDENT_ONLY"},
        "tasks":{"type":"array","minItems":20,"maxItems":30,"uniqueItems":true,"items":{"$ref":"#/$defs/pilotTask"}},
        "topology":{"const":"ISOLATED_HISTORY_FREE"},
        "topology_comparison_artifact_byte_count":{"type":"integer","minimum":1,"maximum":8388608},
        "topology_comparison_artifact_path":{"$ref":"#/$defs/absolutePath"},
        "topology_comparison_artifact_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "collectorRun":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "arm",
        "cleanup_evidence_sha256",
        "collector_manifest_final",
        "collector_run_id",
        "collector_run_root_identity",
        "collector_task_run_id",
        "host",
        "integrity_report",
        "official_result_sha256",
        "reset_evidence_sha256",
        "sequence_index",
        "task_id",
        "unit_id",
        "unit_journal_sha256"
      ],
      "properties":{
        "arm":{"enum":["BASELINE","JOINT_SENTINEL"]},
        "cleanup_evidence_sha256":{"$ref":"#/$defs/sha256"},
        "collector_manifest_final":{"$ref":"#/$defs/manifest"},
        "collector_run_id":{"$ref":"#/$defs/safeId"},
        "collector_run_root_identity":{"$ref":"#/$defs/directoryIdentity"},
        "collector_task_run_id":{"$ref":"#/$defs/safeId"},
        "host":{"enum":["QWEN3_VL","MAI_UI"]},
        "integrity_report":{"$ref":"#/$defs/integrityReport"},
        "official_result_sha256":{"$ref":"#/$defs/sha256"},
        "reset_evidence_sha256":{"$ref":"#/$defs/sha256"},
        "sequence_index":{"type":"integer","minimum":0,"maximum":119},
        "task_id":{"$ref":"#/$defs/safeId"},
        "unit_id":{"type":"string","pattern":"^pilot:[0-9]{3}$"},
        "unit_journal_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "smokeCollectorRun":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "case_id",
        "collector_manifest_final",
        "collector_run_id",
        "collector_run_root_identity",
        "collector_task_run_id",
        "host",
        "integrity_report",
        "mode",
        "sequence_index",
        "stage",
        "task_id",
        "unit_id",
        "unit_journal_sha256"
      ],
      "properties":{
        "case_id":{"$ref":"#/$defs/safeId"},
        "collector_manifest_final":{"$ref":"#/$defs/manifest"},
        "collector_run_id":{"$ref":"#/$defs/safeId"},
        "collector_run_root_identity":{"$ref":"#/$defs/directoryIdentity"},
        "collector_task_run_id":{"$ref":"#/$defs/safeId"},
        "host":{"enum":["QWEN3_VL","MAI_UI"]},
        "integrity_report":{"$ref":"#/$defs/integrityReport"},
        "mode":{"enum":["OFF","SHADOW","ACTIVE"]},
        "sequence_index":{"type":"integer","minimum":0,"maximum":5},
        "stage":{"enum":["QWEN_LIVE_SMOKE","MAI_LIVE_SMOKE"]},
        "task_id":{"$ref":"#/$defs/safeId"},
        "unit_id":{"type":"string","pattern":"^smoke:(QWEN3_VL|MAI_UI):(OFF|SHADOW|ACTIVE)$"},
        "unit_journal_sha256":{"$ref":"#/$defs/sha256"}
      }
    }
  }
}
