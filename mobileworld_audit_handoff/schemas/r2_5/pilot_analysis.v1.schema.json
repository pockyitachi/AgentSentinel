{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsentinel.local/schemas/r2_5/pilot_analysis.v1.schema.json",
  "title": "R2.5 Denominator-Complete Pilot Analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cells",
    "host_arm_groups",
    "limitations",
    "manifest_sha256",
    "matched_host_comparisons",
    "matched_overall",
    "matched_pairs",
    "overall",
    "run_id",
    "schema_version",
    "source_manifest_sha256",
    "source_stage_evidence_sha256",
    "task_groups"
  ],
  "properties": {
    "cells": {
      "type": "array",
      "minItems": 80,
      "maxItems": 120,
      "items": {"$ref": "#/$defs/cell"}
    },
    "host_arm_groups": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/group"},
          {"properties": {"kind": {"const": "HOST_ARM"}}}
        ]
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reason"}
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "matched_host_comparisons": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/matchedComparison"},
          {"properties": {"host": {"$ref": "#/$defs/host"}}}
        ]
      }
    },
    "matched_overall": {
      "allOf": [
        {"$ref": "#/$defs/matchedComparison"},
        {"properties": {"host": {"type": "null"}}}
      ]
    },
    "matched_pairs": {
      "type": "array",
      "minItems": 40,
      "maxItems": 60,
      "items": {"$ref": "#/$defs/matchedPair"}
    },
    "overall": {
      "allOf": [
        {"$ref": "#/$defs/group"},
        {"properties": {"kind": {"const": "OVERALL"}}}
      ]
    },
    "run_id": {"$ref": "#/$defs/runtimeId"},
    "schema_version": {
      "const": "mobileworld.runtime.sentinel-r2.5-pilot-analysis/v1"
    },
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_stage_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "task_groups": {
      "type": "array",
      "minItems": 20,
      "maxItems": 30,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/group"},
          {"properties": {"kind": {"const": "TASK"}}}
        ]
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtimeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "reason": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
    },
    "host": {"enum": ["QWEN3_VL", "MAI_UI"]},
    "arm": {"enum": ["BASELINE", "JOINT_SENTINEL"]},
    "measurementStatus": {
      "enum": ["EXACT", "PARTIAL", "NOT_MEASURABLE", "NOT_APPLICABLE"]
    },
    "terminationReason": {
      "enum": [
        "ACTOR_FINISHED",
        "ACTOR_ENVIRONMENT_FAILURE",
        "ACTOR_UNKNOWN",
        "MAX_STEPS_EXHAUSTED",
        "UNKNOWN_MISSING_AUDIT_DETAIL",
        "UNKNOWN_NONEXECUTED_ACTION"
      ]
    },
    "nullableNonnegativeInteger": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "reason_code"],
      "properties": {
        "classification": {
          "enum": [
            "OBSERVED",
            "NOT_OBSERVED",
            "UNKNOWN",
            "NOT_MEASURABLE",
            "NOT_APPLICABLE"
          ]
        },
        "reason_code": {"$ref": "#/$defs/reason"}
      }
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_status",
        "measured_denominator",
        "metric",
        "missing_count",
        "not_applicable_count",
        "population_count",
        "positive_count",
        "rate_ppm",
        "reason_codes",
        "unit"
      ],
      "properties": {
        "measurement_status": {"$ref": "#/$defs/measurementStatus"},
        "measured_denominator": {"type": "integer", "minimum": 0},
        "metric": {
          "enum": [
            "OFFICIAL_SUCCESS",
            "EDIT",
            "ABSTAIN",
            "FALLBACK",
            "ERROR",
            "UNSUPPORTED",
            "ARCHIVE_SHADOW",
            "CLEAN_HISTORY_FALSE_EDIT",
            "CLEAN_HISTORY_FALSE_ARCHIVE"
          ]
        },
        "missing_count": {"type": "integer", "minimum": 0},
        "not_applicable_count": {"type": "integer", "minimum": 0},
        "population_count": {"type": "integer", "minimum": 0},
        "positive_count": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "rate_ppm": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 1000000},
            {"type": "null"}
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reason"}
        },
        "unit": {"enum": ["CELL", "ACTOR_CALL"]}
      }
    },
    "callRates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/rate"}, {"properties": {"metric": {"const": "EDIT"}}}]},
        {"allOf": [{"$ref": "#/$defs/rate"}, {"properties": {"metric": {"const": "ABSTAIN"}}}]},
        {"allOf": [{"$ref": "#/$defs/rate"}, {"properties": {"metric": {"const": "FALLBACK"}}}]},
        {"allOf": [{"$ref": "#/$defs/rate"}, {"properties": {"metric": {"const": "ERROR"}}}]},
        {"allOf": [{"$ref": "#/$defs/rate"}, {"properties": {"metric": {"const": "UNSUPPORTED"}}}]},
        {"allOf": [{"$ref": "#/$defs/rate"}, {"properties": {"metric": {"const": "ARCHIVE_SHADOW"}}}]},
        {"allOf": [{"$ref": "#/$defs/rate"}, {"properties": {"metric": {"const": "CLEAN_HISTORY_FALSE_EDIT"}}}]},
        {"allOf": [{"$ref": "#/$defs/rate"}, {"properties": {"metric": {"const": "CLEAN_HISTORY_FALSE_ARCHIVE"}}}]}
      ],
      "items": false
    },
    "tokenSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cached_input_tokens",
        "input_tokens",
        "measured_call_denominator",
        "measurement_status",
        "missing_call_count",
        "not_applicable_call_count",
        "output_tokens",
        "population_calls",
        "total_tokens"
      ],
      "properties": {
        "cached_input_tokens": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "input_tokens": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "measured_call_denominator": {"type": "integer", "minimum": 0},
        "measurement_status": {"$ref": "#/$defs/measurementStatus"},
        "missing_call_count": {"type": "integer", "minimum": 0},
        "not_applicable_call_count": {"type": "integer", "minimum": 0},
        "output_tokens": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "population_calls": {"type": "integer", "minimum": 0},
        "total_tokens": {"$ref": "#/$defs/nullableNonnegativeInteger"}
      }
    },
    "stepSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_denominator", "maximum_steps", "minimum_steps", "total_steps"],
      "properties": {
        "cell_denominator": {"type": "integer", "minimum": 0},
        "maximum_steps": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "minimum_steps": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "total_steps": {"type": "integer", "minimum": 0}
      }
    },
    "terminationCounts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"$ref": "#/$defs/actorFinishedCount"},
        {"$ref": "#/$defs/actorEnvironmentFailureCount"},
        {"$ref": "#/$defs/actorUnknownCount"},
        {"$ref": "#/$defs/maxStepsCount"},
        {"$ref": "#/$defs/missingAuditCount"},
        {"$ref": "#/$defs/nonexecutedActionCount"}
      ],
      "items": false
    },
    "terminationCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "reason"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "reason": {"$ref": "#/$defs/terminationReason"}
      }
    },
    "actorFinishedCount": {
      "allOf": [
        {"$ref": "#/$defs/terminationCount"},
        {"properties": {"reason": {"const": "ACTOR_FINISHED"}}}
      ]
    },
    "actorEnvironmentFailureCount": {
      "allOf": [
        {"$ref": "#/$defs/terminationCount"},
        {"properties": {"reason": {"const": "ACTOR_ENVIRONMENT_FAILURE"}}}
      ]
    },
    "actorUnknownCount": {
      "allOf": [
        {"$ref": "#/$defs/terminationCount"},
        {"properties": {"reason": {"const": "ACTOR_UNKNOWN"}}}
      ]
    },
    "maxStepsCount": {
      "allOf": [
        {"$ref": "#/$defs/terminationCount"},
        {"properties": {"reason": {"const": "MAX_STEPS_EXHAUSTED"}}}
      ]
    },
    "missingAuditCount": {
      "allOf": [
        {"$ref": "#/$defs/terminationCount"},
        {"properties": {"reason": {"const": "UNKNOWN_MISSING_AUDIT_DETAIL"}}}
      ]
    },
    "nonexecutedActionCount": {
      "allOf": [
        {"$ref": "#/$defs/terminationCount"},
        {"properties": {"reason": {"const": "UNKNOWN_NONEXECUTED_ACTION"}}}
      ]
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_provider_tokens",
        "arm",
        "audit_detail_missing_count",
        "audit_detail_present_count",
        "call_rates",
        "cost_usd_micros",
        "executed_actions",
        "host",
        "official_score_ppm",
        "official_success",
        "openai_calls",
        "premature_stop",
        "repeated_action",
        "sentinel_openai_tokens",
        "sequence_index",
        "source_cell_sha256",
        "steps",
        "task_id",
        "termination_reason",
        "unnecessary_action",
        "wall_time_ms",
        "wrong_action",
        "wrong_edit"
      ],
      "properties": {
        "actor_provider_tokens": {"$ref": "#/$defs/tokenSummary"},
        "arm": {"$ref": "#/$defs/arm"},
        "audit_detail_missing_count": {"type": "integer", "minimum": 0},
        "audit_detail_present_count": {"type": "integer", "minimum": 0},
        "call_rates": {"$ref": "#/$defs/callRates"},
        "cost_usd_micros": {"type": "integer", "minimum": 0},
        "executed_actions": {"type": "integer", "minimum": 0},
        "host": {"$ref": "#/$defs/host"},
        "official_score_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "official_success": {"type": "boolean"},
        "openai_calls": {"type": "integer", "minimum": 0},
        "premature_stop": {"$ref": "#/$defs/classification"},
        "repeated_action": {"$ref": "#/$defs/classification"},
        "sentinel_openai_tokens": {"$ref": "#/$defs/tokenSummary"},
        "sequence_index": {"type": "integer", "minimum": 0},
        "source_cell_sha256": {"$ref": "#/$defs/sha256"},
        "steps": {"type": "integer", "minimum": 1},
        "task_id": {"$ref": "#/$defs/runtimeId"},
        "termination_reason": {"$ref": "#/$defs/terminationReason"},
        "unnecessary_action": {"$ref": "#/$defs/classification"},
        "wall_time_ms": {"type": "integer", "minimum": 0},
        "wrong_action": {"$ref": "#/$defs/classification"},
        "wrong_edit": {"$ref": "#/$defs/classification"}
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_provider_tokens",
        "arm",
        "call_rates",
        "cell_count",
        "cost_usd_micros",
        "group_id",
        "host",
        "kind",
        "official_success",
        "openai_calls",
        "sentinel_openai_tokens",
        "steps",
        "task_id",
        "termination_counts",
        "wall_time_ms"
      ],
      "properties": {
        "actor_provider_tokens": {"$ref": "#/$defs/tokenSummary"},
        "arm": {"oneOf": [{"$ref": "#/$defs/arm"}, {"type": "null"}]},
        "call_rates": {"$ref": "#/$defs/callRates"},
        "cell_count": {"type": "integer", "minimum": 1},
        "cost_usd_micros": {"type": "integer", "minimum": 0},
        "group_id": {"$ref": "#/$defs/runtimeId"},
        "host": {"oneOf": [{"$ref": "#/$defs/host"}, {"type": "null"}]},
        "kind": {"enum": ["OVERALL", "HOST_ARM", "TASK"]},
        "official_success": {
          "allOf": [
            {"$ref": "#/$defs/rate"},
            {
              "properties": {
                "metric": {"const": "OFFICIAL_SUCCESS"},
                "unit": {"const": "CELL"}
              }
            }
          ]
        },
        "openai_calls": {"type": "integer", "minimum": 0},
        "sentinel_openai_tokens": {"$ref": "#/$defs/tokenSummary"},
        "steps": {"$ref": "#/$defs/stepSummary"},
        "task_id": {
          "oneOf": [
            {"$ref": "#/$defs/runtimeId"},
            {"type": "null"}
          ]
        },
        "termination_counts": {"$ref": "#/$defs/terminationCounts"},
        "wall_time_ms": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "HOST_ARM"}}},
          "then": {
            "properties": {
              "host": {"$ref": "#/$defs/host"},
              "arm": {"$ref": "#/$defs/arm"},
              "task_id": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "TASK"}}},
          "then": {
            "properties": {
              "host": {"type": "null"},
              "arm": {"type": "null"},
              "task_id": {"$ref": "#/$defs/runtimeId"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "OVERALL"}}},
          "then": {
            "properties": {
              "host": {"type": "null"},
              "arm": {"type": "null"},
              "task_id": {"type": "null"}
            }
          }
        }
      ]
    },
    "matchedPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_actor_provider_tokens",
        "baseline_cost_usd_micros",
        "baseline_openai_calls",
        "baseline_sequence_index",
        "baseline_steps",
        "baseline_success",
        "baseline_sentinel_openai_tokens",
        "baseline_termination",
        "baseline_wall_time_ms",
        "host",
        "joint_actor_provider_tokens",
        "joint_cost_usd_micros",
        "joint_minus_baseline_steps",
        "joint_openai_calls",
        "joint_sequence_index",
        "joint_steps",
        "joint_success",
        "joint_sentinel_openai_tokens",
        "joint_termination",
        "joint_wall_time_ms",
        "outcome",
        "task_id",
        "termination_comparable"
      ],
      "properties": {
        "baseline_actor_provider_tokens": {"$ref": "#/$defs/tokenSummary"},
        "baseline_cost_usd_micros": {"type": "integer", "minimum": 0},
        "baseline_openai_calls": {"type": "integer", "minimum": 0},
        "baseline_sequence_index": {"type": "integer", "minimum": 0},
        "baseline_steps": {"type": "integer", "minimum": 1},
        "baseline_success": {"type": "boolean"},
        "baseline_sentinel_openai_tokens": {"$ref": "#/$defs/tokenSummary"},
        "baseline_termination": {"$ref": "#/$defs/terminationReason"},
        "baseline_wall_time_ms": {"type": "integer", "minimum": 0},
        "host": {"$ref": "#/$defs/host"},
        "joint_actor_provider_tokens": {"$ref": "#/$defs/tokenSummary"},
        "joint_cost_usd_micros": {"type": "integer", "minimum": 0},
        "joint_minus_baseline_steps": {"type": "integer"},
        "joint_openai_calls": {"type": "integer", "minimum": 0},
        "joint_sequence_index": {"type": "integer", "minimum": 0},
        "joint_steps": {"type": "integer", "minimum": 1},
        "joint_success": {"type": "boolean"},
        "joint_sentinel_openai_tokens": {"$ref": "#/$defs/tokenSummary"},
        "joint_termination": {"$ref": "#/$defs/terminationReason"},
        "joint_wall_time_ms": {"type": "integer", "minimum": 0},
        "outcome": {
          "enum": ["BOTH_SUCCESS", "BOTH_FAILURE", "JOINT_IMPROVED", "JOINT_REGRESSED"]
        },
        "task_id": {"$ref": "#/$defs/runtimeId"},
        "termination_comparable": {"type": "boolean"}
      }
    },
    "matchedComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_actor_provider_tokens",
        "baseline_cost_usd_micros",
        "baseline_openai_calls",
        "baseline_sentinel_openai_tokens",
        "baseline_success_count",
        "baseline_total_steps",
        "baseline_wall_time_ms",
        "both_failure_count",
        "both_success_count",
        "comparable_termination_pairs",
        "comparison_id",
        "different_termination_count",
        "host",
        "joint_actor_provider_tokens",
        "joint_cost_usd_micros",
        "joint_improved_count",
        "joint_minus_baseline_total_steps",
        "joint_openai_calls",
        "joint_regressed_count",
        "joint_sentinel_openai_tokens",
        "joint_success_count",
        "joint_total_steps",
        "joint_wall_time_ms",
        "missing_termination_pairs",
        "pair_count",
        "same_termination_count"
      ],
      "properties": {
        "baseline_actor_provider_tokens": {"$ref": "#/$defs/tokenSummary"},
        "baseline_cost_usd_micros": {"type": "integer", "minimum": 0},
        "baseline_openai_calls": {"type": "integer", "minimum": 0},
        "baseline_sentinel_openai_tokens": {"$ref": "#/$defs/tokenSummary"},
        "baseline_success_count": {"type": "integer", "minimum": 0},
        "baseline_total_steps": {"type": "integer", "minimum": 0},
        "baseline_wall_time_ms": {"type": "integer", "minimum": 0},
        "both_failure_count": {"type": "integer", "minimum": 0},
        "both_success_count": {"type": "integer", "minimum": 0},
        "comparable_termination_pairs": {"type": "integer", "minimum": 0},
        "comparison_id": {"$ref": "#/$defs/runtimeId"},
        "different_termination_count": {"type": "integer", "minimum": 0},
        "host": {"oneOf": [{"$ref": "#/$defs/host"}, {"type": "null"}]},
        "joint_actor_provider_tokens": {"$ref": "#/$defs/tokenSummary"},
        "joint_cost_usd_micros": {"type": "integer", "minimum": 0},
        "joint_improved_count": {"type": "integer", "minimum": 0},
        "joint_minus_baseline_total_steps": {"type": "integer"},
        "joint_openai_calls": {"type": "integer", "minimum": 0},
        "joint_regressed_count": {"type": "integer", "minimum": 0},
        "joint_sentinel_openai_tokens": {"$ref": "#/$defs/tokenSummary"},
        "joint_success_count": {"type": "integer", "minimum": 0},
        "joint_total_steps": {"type": "integer", "minimum": 0},
        "joint_wall_time_ms": {"type": "integer", "minimum": 0},
        "missing_termination_pairs": {"type": "integer", "minimum": 0},
        "pair_count": {"type": "integer", "minimum": 0},
        "same_termination_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
