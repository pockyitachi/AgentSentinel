{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsentinel.local/schemas/r2_4/history_policy_request_proof.v1.schema.json",
  "title": "R2.4 Owner-Only History Policy Request Proof v1",
  "description": "Restricted durable preimage proof for one formed owner-authorized HISTORY_POLICY attempt. It binds the complete attempt authority and independently derived deadline constraint to the case lease, stage, pricing, transport, exact canonical R2.4 physical Responses request and provider-output schema, the distinct accepted R2.2 local-validation schema, optional provider response, and R2.2 receipt provenance. It must not enter ordinary logs or public hash-only receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor_request_sha256",
    "attempt_authority",
    "attempt_authority_sha256",
    "attempt_dispatch_count",
    "attempt_id",
    "attempt_receipt_sha256",
    "attempt_role",
    "attempt_status",
    "case_execution_lease",
    "constraint_binding",
    "coordinator_evidence_packet_sha256",
    "deadline_binding",
    "logical_call_id",
    "openai_stage",
    "rubric_openai_stage",
    "pricing",
    "provider_output_schema_sha256",
    "provider_request",
    "provider_request_byte_count",
    "provider_request_sha256",
    "r22_output_schema_sha256",
    "r22_policy_receipt",
    "r22_policy_receipt_sha256",
    "r22_receipt_failure_code",
    "r22_receipt_state",
    "response_envelope",
    "schema_version",
    "transport_binding"
  ],
  "properties": {
    "actor_request_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_authority": {"$ref": "#/$defs/attemptAuthority"},
    "attempt_authority_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_dispatch_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "attempt_id": {"$ref": "#/$defs/runtimeId"},
    "attempt_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_role": {"const": "HISTORY_POLICY"},
    "attempt_status": {
      "enum": [
        "COMPLETED",
        "FAILED",
        "CANCELLED_PRE_DISPATCH",
        "CANCELLED_POST_DISPATCH",
        "TERMINATION_UNCONFIRMED"
      ]
    },
    "case_execution_lease": {
      "$ref": "https://agentsentinel.local/schemas/r2_4/rubric_request_proof.v1.schema.json#/$defs/caseExecutionLease"
    },
    "constraint_binding": {
      "$ref": "https://agentsentinel.local/schemas/r2_4/rubric_request_proof.v1.schema.json#/$defs/attemptConstraintBinding"
    },
    "coordinator_evidence_packet_sha256": {"$ref": "#/$defs/sha256"},
    "deadline_binding": {"$ref": "#/$defs/deadlineBinding"},
    "logical_call_id": {"$ref": "#/$defs/runtimeId"},
    "openai_stage": {
      "$ref": "https://agentsentinel.local/schemas/r2_4/rubric_request_proof.v1.schema.json#/$defs/historyOpenAIStage"
    },
    "rubric_openai_stage": {
      "$ref": "https://agentsentinel.local/schemas/r2_4/rubric_request_proof.v1.schema.json#/$defs/openAIStage"
    },
    "pricing": {
      "$ref": "https://agentsentinel.local/schemas/r2_4/rubric_request_proof.v1.schema.json#/$defs/pricing"
    },
    "provider_output_schema_sha256": {"$ref": "#/$defs/sha256"},
    "provider_request": {"$ref": "#/$defs/providerRequest"},
    "provider_request_byte_count": {"type": "integer", "minimum": 2, "maximum": 8388608},
    "provider_request_sha256": {"$ref": "#/$defs/sha256"},
    "r22_output_schema_sha256": {"$ref": "#/$defs/sha256"},
    "r22_policy_receipt": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "https://agentsentinel.local/schemas/r2_2/policy_receipt.v1.schema.json"}
      ]
    },
    "r22_policy_receipt_sha256": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
    },
    "r22_receipt_failure_code": {
      "oneOf": [
        {"type": "null"},
        {
          "enum": [
            "POLICY_RECEIPT_PREPARE_FAILED",
            "POLICY_RECEIPT_PREPARE_MUTATED",
            "POLICY_RECEIPT_PUBLISH_FAILED",
            "POLICY_RECEIPT_PUBLISH_MUTATED",
            "POLICY_DEADLINE_EXCEEDED"
          ]
        }
      ]
    },
    "r22_receipt_state": {
      "enum": [
        "R22_RECEIPT_COMMITTED",
        "R22_RECEIPT_ABSENT_PRE_DISPATCH",
        "R22_RECEIPT_ABSENT_POST_DISPATCH"
      ]
    },
    "response_envelope": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/responseEnvelope"}]
    },
    "schema_version": {
      "const": "mobileworld.runtime.sentinel-r2.4-history-policy-request-proof/v1"
    },
    "transport_binding": {"$ref": "#/$defs/transportBinding"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"attempt_status": {"const": "COMPLETED"}},
        "required": ["attempt_status"]
      },
      "then": {
        "properties": {
          "attempt_dispatch_count": {"const": 1},
          "response_envelope": {"$ref": "#/$defs/responseEnvelope"}
        },
        "oneOf": [
          {
            "properties": {
              "r22_policy_receipt": {
                "$ref": "https://agentsentinel.local/schemas/r2_2/policy_receipt.v1.schema.json"
              },
              "r22_policy_receipt_sha256": {"$ref": "#/$defs/sha256"},
              "r22_receipt_failure_code": {"type": "null"},
              "r22_receipt_state": {"const": "R22_RECEIPT_COMMITTED"}
            }
          },
          {
            "properties": {
              "r22_policy_receipt": {"type": "null"},
              "r22_policy_receipt_sha256": {"type": "null"},
              "r22_receipt_failure_code": {
                "enum": [
                  "POLICY_RECEIPT_PREPARE_FAILED",
                  "POLICY_RECEIPT_PREPARE_MUTATED",
                  "POLICY_RECEIPT_PUBLISH_FAILED",
                  "POLICY_RECEIPT_PUBLISH_MUTATED",
                  "POLICY_DEADLINE_EXCEEDED"
                ]
              },
              "r22_receipt_state": {"const": "R22_RECEIPT_ABSENT_POST_DISPATCH"}
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {"attempt_status": {"const": "CANCELLED_PRE_DISPATCH"}},
        "required": ["attempt_status"]
      },
      "then": {"properties": {"attempt_dispatch_count": {"const": 0}}}
    },
    {
      "if": {
        "properties": {"r22_receipt_state": {"const": "R22_RECEIPT_COMMITTED"}},
        "required": ["r22_receipt_state"]
      },
      "then": {
        "properties": {
          "r22_policy_receipt": {
            "$ref": "https://agentsentinel.local/schemas/r2_2/policy_receipt.v1.schema.json"
          },
          "r22_policy_receipt_sha256": {"$ref": "#/$defs/sha256"},
          "r22_receipt_failure_code": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "r22_policy_receipt": {"type": "null"},
          "r22_policy_receipt_sha256": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtimeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "attemptAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_request_sha256", "attempt_id", "case_id",
        "case_execution_lease_sha256", "deadline_monotonic_ns",
        "logical_call_id", "manifest_sha256", "max_cost_usd_micros",
        "max_output_tokens", "preflight_sha256", "pricing_binding_sha256",
        "request_sha256", "role", "schema_version", "stage_sha256",
        "transport_binding_sha256"
      ],
      "properties": {
        "actor_request_sha256": {"$ref": "#/$defs/sha256"},
        "attempt_id": {"$ref": "#/$defs/runtimeId"},
        "case_id": {"$ref": "#/$defs/runtimeId"},
        "case_execution_lease_sha256": {"$ref": "#/$defs/sha256"},
        "deadline_monotonic_ns": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "logical_call_id": {"$ref": "#/$defs/runtimeId"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "max_cost_usd_micros": {"type": "integer", "minimum": 0, "maximum": 100000000000},
        "max_output_tokens": {"const": 4096},
        "preflight_sha256": {"$ref": "#/$defs/sha256"},
        "pricing_binding_sha256": {"$ref": "#/$defs/sha256"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "role": {"const": "HISTORY_POLICY"},
        "schema_version": {"const": "mobileworld.runtime.sentinel-r2.4-live-attempt-authority/v1"},
        "stage_sha256": {"$ref": "#/$defs/sha256"},
        "transport_binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "deadlineBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id", "begin_observed_monotonic_ns", "case_execution_deadline_monotonic_ns",
        "case_execution_lease_sha256", "case_id", "constraint_registered_monotonic_ns",
        "effective_deadline_monotonic_ns", "logical_call_id", "max_cost_usd_micros",
        "request_timeout_ns", "requested_call_deadline_monotonic_ns",
        "requested_deadline_issued_monotonic_ns", "schema_version"
      ],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/runtimeId"},
        "begin_observed_monotonic_ns": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "case_execution_deadline_monotonic_ns": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "case_execution_lease_sha256": {"$ref": "#/$defs/sha256"},
        "case_id": {"$ref": "#/$defs/runtimeId"},
        "constraint_registered_monotonic_ns": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "effective_deadline_monotonic_ns": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "logical_call_id": {"$ref": "#/$defs/runtimeId"},
        "max_cost_usd_micros": {"type": "integer", "minimum": 0, "maximum": 100000000000},
        "request_timeout_ns": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "requested_call_deadline_monotonic_ns": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "requested_deadline_issued_monotonic_ns": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "schema_version": {"const": "mobileworld.runtime.sentinel-r2.4-live-attempt-deadline-binding/v1"}
      }
    },
    "transportBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_request_sha256", "authority_manifest_sha256", "case_execution_lease_sha256",
        "child_process_isolated", "client_origin", "client_timeout_ceiling_ns",
        "descriptor_sha256", "environment_proxy_disabled", "factory_binding_sha256",
        "history_policy_stage_sha256", "max_output_tokens", "preflight_report_sha256",
        "pricing_binding_sha256", "requested_model", "responses_endpoint",
        "responses_endpoint_sha256", "schema_version", "seam_policy_deadline_ns",
        "transport_timeout_ns"
      ],
      "properties": {
        "actor_request_sha256": {"$ref": "#/$defs/sha256"},
        "authority_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "case_execution_lease_sha256": {"$ref": "#/$defs/sha256"},
        "child_process_isolated": {"const": true},
        "client_origin": {"const": "MODULE_OWNED_PRODUCTION"},
        "client_timeout_ceiling_ns": {"type": "integer", "minimum": 1},
        "descriptor_sha256": {"$ref": "#/$defs/sha256"},
        "environment_proxy_disabled": {"const": true},
        "factory_binding_sha256": {"$ref": "#/$defs/sha256"},
        "history_policy_stage_sha256": {"$ref": "#/$defs/sha256"},
        "max_output_tokens": {"const": 4096},
        "preflight_report_sha256": {"$ref": "#/$defs/sha256"},
        "pricing_binding_sha256": {"$ref": "#/$defs/sha256"},
        "requested_model": {"const": "gpt-5.6-sol"},
        "responses_endpoint": {"const": "https://api.openai.com/v1/responses"},
        "responses_endpoint_sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "mobileworld.runtime.sentinel-openai-responses-transport-binding/v1"},
        "seam_policy_deadline_ns": {"type": "integer", "minimum": 1},
        "transport_timeout_ns": {"type": "integer", "minimum": 1}
      }
    },
    "providerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input", "instructions", "max_output_tokens", "model",
        "parallel_tool_calls", "reasoning", "store", "stream", "text",
        "tool_choice", "tools", "truncation"
      ],
      "properties": {
        "input": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["content", "role"],
            "properties": {
              "role": {"const": "user"},
              "content": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["text", "type"],
                    "properties": {
                      "text": {"type": "string", "minLength": 2, "maxLength": 2097152},
                      "type": {"const": "input_text"}
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["detail", "image_url", "type"],
                    "properties": {
                      "detail": {"const": "high"},
                      "image_url": {
                        "type": "string",
                        "pattern": "^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]*={0,2}$"
                      },
                      "type": {"const": "input_image"}
                    }
                  }
                ],
                "items": false
              }
            }
          }
        },
        "instructions": {"type": "string", "minLength": 1, "maxLength": 16384},
        "max_output_tokens": {"const": 4096},
        "model": {"const": "gpt-5.6-sol"},
        "parallel_tool_calls": {"const": false},
        "reasoning": {
          "type": "object",
          "additionalProperties": false,
          "required": ["effort"],
          "properties": {"effort": {"const": "medium"}}
        },
        "store": {"const": false},
        "stream": {"const": false},
        "text": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "verbosity"],
          "properties": {
            "format": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "schema", "strict", "type"],
              "properties": {
                "name": {"const": "r24_history_policy_transport_output_v1"},
                "schema": {"type": "object"},
                "strict": {"const": true},
                "type": {"const": "json_schema"}
              }
            },
            "verbosity": {"const": "low"}
          }
        },
        "tool_choice": {"const": "none"},
        "tools": {"type": "array", "maxItems": 0},
        "truncation": {"const": "disabled"}
      }
    },
    "responseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens", "output_text", "output_tokens", "requested_model",
        "response_id", "returned_model", "schema_version", "service_tier",
        "status", "total_tokens"
      ],
      "properties": {
        "input_tokens": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
        "output_text": {"type": "string", "minLength": 1, "maxLength": 2097152},
        "output_tokens": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
        "requested_model": {"const": "gpt-5.6-sol"},
        "response_id": {"$ref": "#/$defs/runtimeId"},
        "returned_model": {"const": "gpt-5.6-sol"},
        "schema_version": {"const": "mobileworld.runtime.sentinel-gpt56-response-envelope/v1"},
        "service_tier": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/runtimeId"}]},
        "status": {"const": "completed"},
        "total_tokens": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]}
      }
    }
  }
}
