{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsentinel.local/schemas/r2_4/rubric_request_proof.v1.schema.json",
  "title": "R2.4 Owner-Only Live Rubric Request Proof v1",
  "description": "Restricted durable preimage proof for one admitted owner-authorized live rubric attempt. This artifact binds the full attempt authority and its independently derived deadline/cost constraint to the lease, stages, pricing, transport, exact task, Collector stimulus, current image when tracking, provider input, sealed OpenAI Responses request, and ordered terminal receipt; it must never enter ordinary logs or the public hash-only receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "task_run_id",
    "logical_call_id",
    "attempt_id",
    "attempt_order",
    "attempt_role",
    "attempt_status",
    "attempt_dispatch_count",
    "attempt_receipt_sha256",
    "attempt_authority",
    "attempt_authority_sha256",
    "attempt_constraint_binding",
    "case_execution_lease",
    "openai_stage",
    "pricing",
    "transport_binding",
    "backend_extension_descriptor_sha256",
    "r23_compatibility_descriptor_sha256",
    "collector_stimulus",
    "collector_stimulus_sha256",
    "tracking_packet_sha256",
    "current_image",
    "provider_input",
    "provider_input_sha256",
    "provider_request",
    "provider_request_sha256",
    "provider_request_byte_count"
  ],
  "properties": {
    "schema_version": {
      "const": "mobileworld.runtime.sentinel-r2.4-live-rubric-request-proof/v1"
    },
    "operation": {"enum": ["GENERATE", "TRACK"]},
    "task_run_id": {"$ref": "#/$defs/runtimeId"},
    "logical_call_id": {"$ref": "#/$defs/runtimeId"},
    "attempt_id": {"$ref": "#/$defs/runtimeId"},
    "attempt_order": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "attempt_role": {"const": "RUBRIC"},
    "attempt_status": {
      "enum": [
        "COMPLETED",
        "CANCELLED_PRE_DISPATCH",
        "CANCELLED_POST_DISPATCH",
        "TERMINATION_UNCONFIRMED",
        "FAILED"
      ]
    },
    "attempt_dispatch_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "attempt_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_authority": {"$ref": "#/$defs/attemptAuthority"},
    "attempt_authority_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_constraint_binding": {"$ref": "#/$defs/attemptConstraintBinding"},
    "case_execution_lease": {"$ref": "#/$defs/caseExecutionLease"},
    "openai_stage": {"$ref": "#/$defs/openAIStage"},
    "pricing": {"$ref": "#/$defs/pricing"},
    "transport_binding": {"$ref": "#/$defs/transportBinding"},
    "backend_extension_descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "r23_compatibility_descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "collector_stimulus": {"$ref": "#/$defs/collectorStimulus"},
    "collector_stimulus_sha256": {"$ref": "#/$defs/sha256"},
    "tracking_packet_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "current_image": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/currentImage"}
      ]
    },
    "provider_input": {
      "oneOf": [
        {"$ref": "#/$defs/generateProviderInput"},
        {"$ref": "#/$defs/trackProviderInput"}
      ]
    },
    "provider_input_sha256": {"$ref": "#/$defs/sha256"},
    "provider_request": {"$ref": "#/$defs/providerRequest"},
    "provider_request_sha256": {"$ref": "#/$defs/sha256"},
    "provider_request_byte_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 8388608
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"operation": {"const": "GENERATE"}},
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "current_image": {"type": "null"},
          "tracking_packet_sha256": {"type": "null"},
          "provider_input": {"$ref": "#/$defs/generateProviderInput"},
          "provider_request": {
            "allOf": [
              {"$ref": "#/$defs/providerRequest"},
              {
                "properties": {
                  "instructions": {"const": "You are the isolated MobileWorld task-rubric generator. Convert only the exact task instruction into a complete multi-path AND/OR milestone graph. For each instruction span, copy exact_text byte-for-byte and give only its zero-based Unicode char_start; the runtime derives all end and UTF-8 offsets. Every instruction span must be cited by exactly one instruction-bound milestone whose kind matches the span role, whose predicate_kind is INSTRUCTION_REQUIREMENT, and whose state_description exactly equals the span exact_text. Include every hard requirement, constraint, and terminal requirement without adding requirements. Every graph reference must resolve, every milestone and gate must be reachable, gates must be acyclic with at least two distinct children, and IDs must be unique. Include at least one LEGAL_ALTERNATIVE path with a non-null root and exactly one OTHER_UNKNOWN path with a null root. Use common_root only for requirements shared by every legal alternative. Do not infer factual truth, inspect history, recommend actions, or emit GUI action coordinates/tool calls. Return only JSON matching the supplied schema."},
                  "input": {"$ref": "#/$defs/generateInputMessages"},
                  "text": {"$ref": "#/$defs/generateTextConfiguration"}
                }
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "current_image": {"$ref": "#/$defs/currentImage"},
          "tracking_packet_sha256": {"$ref": "#/$defs/sha256"},
          "provider_input": {"$ref": "#/$defs/trackProviderInput"},
          "provider_request": {
            "allOf": [
              {"$ref": "#/$defs/providerRequest"},
              {
                "properties": {
                  "instructions": {"const": "You are the isolated MobileWorld rubric tracker. Evaluate every frozen milestone only from the supplied history-free packet and the current screenshot. Actor history, History IR, policy output, future events, benchmark checker results, and replay outcomes are absent and forbidden. Generic transition success, screenshot change, and free-form tool text are weak evidence and cannot alone establish satisfaction or violation. Cite exact evidence IDs and payload hashes. On ambiguity, conflict, or insufficiency use unknown; ABSTAIN requires every milestone unknown. Do not recommend or execute an action. Return only JSON matching the supplied schema."},
                  "input": {"$ref": "#/$defs/trackInputMessages"},
                  "text": {"$ref": "#/$defs/trackTextConfiguration"}
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "attempt_status": {
            "enum": ["COMPLETED", "CANCELLED_POST_DISPATCH"]
          }
        },
        "required": ["attempt_status"]
      },
      "then": {
        "properties": {"attempt_dispatch_count": {"const": 1}}
      }
    },
    {
      "if": {
        "properties": {
          "attempt_status": {"const": "CANCELLED_PRE_DISPATCH"}
        },
        "required": ["attempt_status"]
      },
      "then": {
        "properties": {"attempt_dispatch_count": {"const": 0}}
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtimeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "attemptAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "actor_request_sha256",
        "case_id",
        "case_execution_lease_sha256",
        "deadline_monotonic_ns",
        "logical_call_id",
        "manifest_sha256",
        "max_cost_usd_micros",
        "max_output_tokens",
        "preflight_sha256",
        "pricing_binding_sha256",
        "request_sha256",
        "role",
        "schema_version",
        "stage_sha256",
        "transport_binding_sha256"
      ],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/runtimeId"},
        "actor_request_sha256": {"$ref": "#/$defs/sha256"},
        "case_id": {"$ref": "#/$defs/runtimeId"},
        "case_execution_lease_sha256": {"$ref": "#/$defs/sha256"},
        "deadline_monotonic_ns": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "logical_call_id": {"$ref": "#/$defs/runtimeId"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "max_cost_usd_micros": {"type": "integer", "minimum": 0, "maximum": 100000000000},
        "max_output_tokens": {"const": 8192},
        "preflight_sha256": {"$ref": "#/$defs/sha256"},
        "pricing_binding_sha256": {"$ref": "#/$defs/sha256"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "role": {"const": "RUBRIC"},
        "schema_version": {"const": "mobileworld.runtime.sentinel-r2.4-live-attempt-authority/v1"},
        "stage_sha256": {"$ref": "#/$defs/sha256"},
        "transport_binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "caseExecutionLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_call_index", "case_id", "execution_scope", "expires_at_utc",
        "factory_binding_sha256", "host", "issued_at_utc", "manifest_sha256",
        "mode", "openai_stage_set_sha256", "preflight_report_sha256",
        "pricing_binding_sha256", "request_sha256", "reset_seed", "schema_version",
        "stage", "task_id", "task_parameters_sha256"
      ],
      "properties": {
        "actor_call_index": {"type": "integer", "minimum": 1},
        "case_id": {"$ref": "#/$defs/runtimeId"},
        "execution_scope": {"const": "OWNER_AUTHORIZED_LIVE"},
        "expires_at_utc": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "factory_binding_sha256": {"$ref": "#/$defs/sha256"},
        "host": {"enum": ["QWEN3_VL", "MAI_UI"]},
        "issued_at_utc": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "mode": {"enum": ["OFF", "SHADOW", "ACTIVE"]},
        "openai_stage_set_sha256": {"$ref": "#/$defs/sha256"},
        "preflight_report_sha256": {"$ref": "#/$defs/sha256"},
        "pricing_binding_sha256": {"$ref": "#/$defs/sha256"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "reset_seed": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 2147483647}]},
        "schema_version": {"const": "mobileworld.runtime.sentinel-r2.4-case-execution-lease/v1"},
        "stage": {"enum": ["QWEN_LIVE_SMOKE", "MAI_LIVE_SMOKE", "R25_PILOT"]},
        "task_id": {"$ref": "#/$defs/runtimeId"},
        "task_parameters_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
      }
    },
    "attemptConstraintBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_max_cost_usd_micros", "case_execution_deadline_monotonic_ns",
        "case_host", "case_id", "case_max_cost_usd_micros", "case_mode",
        "case_stage", "effective_deadline_monotonic_ns", "history_stage",
        "issued_monotonic_ns", "max_actor_calls", "max_openai_calls",
        "max_wall_time_seconds", "requested_call_deadline_monotonic_ns",
        "reset_seed", "rubric_stage_sha256", "rubric_stage_timeout_ms",
        "schema_version", "task_id", "task_parameters_sha256"
      ],
      "properties": {
        "attempt_max_cost_usd_micros": {"type": "integer", "minimum": 1, "maximum": 100000000000},
        "case_execution_deadline_monotonic_ns": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "case_host": {"enum": ["QWEN3_VL", "MAI_UI"]},
        "case_id": {"$ref": "#/$defs/runtimeId"},
        "case_max_cost_usd_micros": {"type": "integer", "minimum": 1, "maximum": 100000000000},
        "case_mode": {"enum": ["SHADOW", "ACTIVE"]},
        "case_stage": {"enum": ["QWEN_LIVE_SMOKE", "MAI_LIVE_SMOKE", "R25_PILOT"]},
        "effective_deadline_monotonic_ns": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "history_stage": {"$ref": "#/$defs/historyOpenAIStage"},
        "issued_monotonic_ns": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "max_actor_calls": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_openai_calls": {"type": "integer", "minimum": 1, "maximum": 2000001},
        "max_wall_time_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000},
        "requested_call_deadline_monotonic_ns": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "reset_seed": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 2147483647}]},
        "rubric_stage_sha256": {"$ref": "#/$defs/sha256"},
        "rubric_stage_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 86400000},
        "schema_version": {"const": "mobileworld.runtime.sentinel-r2.4-live-rubric-attempt-constraint/v1"},
        "task_id": {"$ref": "#/$defs/runtimeId"},
        "task_parameters_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
      }
    },
    "historyOpenAIStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint", "external_network_on_call", "max_attempts", "max_output_tokens",
        "model", "model_on_call", "openai_sdk_version", "role", "sdk_max_retries",
        "store", "timeout_ms", "transport_authority", "transport_kind"
      ],
      "properties": {
        "endpoint": {"const": "https://api.openai.com/v1/responses"},
        "external_network_on_call": {"const": true},
        "max_attempts": {"const": 1},
        "max_output_tokens": {"const": 4096},
        "model": {"const": "gpt-5.6-sol"},
        "model_on_call": {"const": true},
        "openai_sdk_version": {"const": "1.106.1"},
        "role": {"const": "HISTORY_POLICY"},
        "sdk_max_retries": {"const": 0},
        "store": {"const": false},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 300000},
        "transport_authority": {"const": "EXPLICIT_OWNER_AUTHORIZATION"},
        "transport_kind": {"const": "OPENAI_RESPONSES"}
      }
    },
    "openAIStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint", "external_network_on_call", "max_attempts", "max_output_tokens",
        "model", "model_on_call", "openai_sdk_version", "role", "sdk_max_retries",
        "store", "timeout_ms", "transport_authority", "transport_kind"
      ],
      "properties": {
        "endpoint": {"const": "https://api.openai.com/v1/responses"},
        "external_network_on_call": {"const": true},
        "max_attempts": {"const": 1},
        "max_output_tokens": {"const": 8192},
        "model": {"const": "gpt-5.6-sol"},
        "model_on_call": {"const": true},
        "openai_sdk_version": {"const": "1.106.1"},
        "role": {"const": "RUBRIC"},
        "sdk_max_retries": {"const": 0},
        "store": {"const": false},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 300000},
        "transport_authority": {"const": "EXPLICIT_OWNER_AUTHORIZATION"},
        "transport_kind": {"const": "OPENAI_RESPONSES"}
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cached_input_usd_micros_per_million_tokens", "effective_at_utc",
        "input_usd_micros_per_million_tokens", "model",
        "output_usd_micros_per_million_tokens", "pricing_id", "rounding_policy",
        "schema_version", "source_sha256"
      ],
      "properties": {
        "cached_input_usd_micros_per_million_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "effective_at_utc": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "input_usd_micros_per_million_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "model": {"const": "gpt-5.6-sol"},
        "output_usd_micros_per_million_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "pricing_id": {"$ref": "#/$defs/runtimeId"},
        "rounding_policy": {"const": "CEIL_PER_ATTEMPT_USD_MICRO"},
        "schema_version": {"const": "mobileworld.runtime.sentinel-r2.4-live-pricing/v1"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "transportBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_extension_descriptor_sha256", "execution_scope", "factory_binding_sha256",
        "input_schema_version", "manifest_sha256", "model", "operation",
        "output_schema_sha256", "preflight_sha256", "pricing_binding_sha256",
        "prompt_sha256", "role", "stage_sha256"
      ],
      "properties": {
        "backend_extension_descriptor_sha256": {"$ref": "#/$defs/sha256"},
        "execution_scope": {"const": "OWNER_AUTHORIZED_LIVE"},
        "factory_binding_sha256": {"$ref": "#/$defs/sha256"},
        "input_schema_version": {"enum": ["mobileworld.runtime.sentinel-r2.4-live-rubric-generate-input/v1", "mobileworld.runtime.sentinel-r2.4-live-rubric-track-input/v1"]},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "model": {"const": "gpt-5.6-sol"},
        "operation": {"enum": ["GENERATE", "TRACK"]},
        "output_schema_sha256": {"$ref": "#/$defs/sha256"},
        "preflight_sha256": {"$ref": "#/$defs/sha256"},
        "pricing_binding_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "role": {"const": "RUBRIC"},
        "stage_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "collectorStimulus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_run_id",
        "step_id",
        "cutoff",
        "task",
        "current_observation",
        "evidence_index"
      ],
      "properties": {
        "schema_version": {
          "const": "mobileworld.runtime.sentinel-r2.4-rubric-stimulus/v1"
        },
        "task_run_id": {"$ref": "#/$defs/runtimeId"},
        "step_id": {"$ref": "#/$defs/runtimeId"},
        "cutoff": {
          "$ref": "https://agentsentinel.local/schemas/r2_3/tracking_packet.v1.schema.json#/$defs/cutoff"
        },
        "task": {
          "$ref": "https://agentsentinel.local/schemas/r2_3/tracking_packet.v1.schema.json#/$defs/task"
        },
        "current_observation": {
          "$ref": "https://agentsentinel.local/schemas/r2_3/tracking_packet.v1.schema.json#/$defs/currentObservation"
        },
        "evidence_index": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "https://agentsentinel.local/schemas/r2_3/tracking_packet.v1.schema.json#/$defs/evidence"
          }
        }
      }
    },
    "backendDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_id",
        "backend_version",
        "prompt_sha256",
        "rubric_schema_sha256",
        "tracking_packet_schema_sha256",
        "tracker_schema_sha256",
        "config_sha256",
        "backend_kind",
        "transport_authority",
        "external_network_attempted",
        "model_call_attempted",
        "local_gpu_used"
      ],
      "properties": {
        "backend_id": {"$ref": "#/$defs/runtimeId"},
        "backend_version": {"$ref": "#/$defs/runtimeId"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "rubric_schema_sha256": {"$ref": "#/$defs/sha256"},
        "tracking_packet_schema_sha256": {"$ref": "#/$defs/sha256"},
        "tracker_schema_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "backend_kind": {"const": "INJECTED_FAKE"},
        "transport_authority": {"const": "CPU_OFFLINE_FAKE"},
        "external_network_attempted": {"const": false},
        "model_call_attempted": {"const": false},
        "local_gpu_used": {"const": false}
      }
    },
    "generateProviderInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_extension_descriptor_sha256",
        "r23_compatibility_descriptor_sha256",
        "request",
        "schema_version"
      ],
      "properties": {
        "backend_extension_descriptor_sha256": {"$ref": "#/$defs/sha256"},
        "r23_compatibility_descriptor_sha256": {"$ref": "#/$defs/sha256"},
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request_id", "task_run_id", "task", "backend"],
          "properties": {
            "request_id": {"$ref": "#/$defs/runtimeId"},
            "task_run_id": {"$ref": "#/$defs/runtimeId"},
            "task": {
              "$ref": "https://agentsentinel.local/schemas/r2_3/tracking_packet.v1.schema.json#/$defs/task"
            },
            "backend": {"$ref": "#/$defs/backendDescriptor"}
          }
        },
        "schema_version": {
          "const": "mobileworld.runtime.sentinel-r2.4-live-rubric-generate-input/v1"
        }
      }
    },
    "trackProviderInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_extension_descriptor_sha256",
        "r23_compatibility_descriptor_sha256",
        "current_image_binding_sha256",
        "packet",
        "schema_version"
      ],
      "properties": {
        "backend_extension_descriptor_sha256": {"$ref": "#/$defs/sha256"},
        "r23_compatibility_descriptor_sha256": {"$ref": "#/$defs/sha256"},
        "current_image_binding_sha256": {"$ref": "#/$defs/sha256"},
        "packet": {
          "$ref": "https://agentsentinel.local/schemas/r2_3/tracking_packet.v1.schema.json"
        },
        "schema_version": {
          "const": "mobileworld.runtime.sentinel-r2.4-live-rubric-track-input/v1"
        }
      }
    },
    "currentImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_run_id",
        "logical_call_id",
        "source_event_id",
        "source_event_seq",
        "evidence_id",
        "content_sha256",
        "media_type",
        "width",
        "height",
        "data_url",
        "stimulus_sha256",
        "binding_sha256"
      ],
      "properties": {
        "task_run_id": {"$ref": "#/$defs/runtimeId"},
        "logical_call_id": {"$ref": "#/$defs/runtimeId"},
        "source_event_id": {"$ref": "#/$defs/runtimeId"},
        "source_event_seq": {"type": "integer", "minimum": 1},
        "evidence_id": {"$ref": "#/$defs/runtimeId"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"enum": ["image/png", "image/jpeg", "image/webp"]},
        "width": {"type": "integer", "minimum": 1, "maximum": 32768},
        "height": {"type": "integer", "minimum": 1, "maximum": 32768},
        "data_url": {
          "type": "string",
          "minLength": 25,
          "maxLength": 60000000,
          "pattern": "^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]*={0,2}$"
        },
        "stimulus_sha256": {"$ref": "#/$defs/sha256"},
        "binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inputText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": {"const": "input_text"},
        "text": {"type": "string", "minLength": 2, "maxLength": 8388608}
      }
    },
    "inputImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "image_url", "detail"],
      "properties": {
        "type": {"const": "input_image"},
        "image_url": {
          "type": "string",
          "minLength": 25,
          "maxLength": 60000000,
          "pattern": "^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]*={0,2}$"
        },
        "detail": {"const": "high"}
      }
    },
    "generateInputMessages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "content"],
          "properties": {
            "role": {"const": "user"},
            "content": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [{"$ref": "#/$defs/inputText"}],
              "items": false
            }
          }
        }
      ],
      "items": false
    },
    "trackInputMessages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "content"],
          "properties": {
            "role": {"const": "user"},
            "content": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {"$ref": "#/$defs/inputText"},
                {"$ref": "#/$defs/inputImage"}
              ],
              "items": false
            }
          }
        }
      ],
      "items": false
    },
    "generateTextConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "verbosity"],
      "properties": {
        "format": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "strict", "schema"],
          "properties": {
            "type": {"const": "json_schema"},
            "name": {"const": "r24_live_rubric_generate_v1"},
            "strict": {"const": true},
            "schema": {
              "const": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "$id": "https://agentsentinel.local/schemas/r2_4/rubric_generate_output.v1.schema.json",
                "title": "R2.4 Live Rubric Generate Output v1",
                "type": "object",
                "additionalProperties": false,
                "required": ["instruction_spans", "milestones", "gates", "common_root", "paths"],
                "properties": {
                  "instruction_spans": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/instructionSpan"}},
                  "milestones": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/milestone"}},
                  "gates": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/gate"}},
                  "common_root": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/graphRef"}]},
                  "paths": {"type": "array", "minItems": 2, "maxItems": 128, "items": {"$ref": "#/$defs/path"}}
                },
                "$defs": {
                  "semanticId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
                  "instructionSpan": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["span_id", "role", "char_start", "exact_text"],
                    "properties": {
                      "span_id": {"$ref": "#/$defs/semanticId"},
                      "role": {"enum": ["HARD_REQUIREMENT", "CONSTRAINT", "TERMINAL_REQUIREMENT"]},
                      "char_start": {"type": "integer", "minimum": 0},
                      "exact_text": {"type": "string", "minLength": 1, "maxLength": 32768}
                    }
                  },
                  "milestone": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["milestone_id", "kind", "predicate_kind", "state_description", "instruction_span_id"],
                    "properties": {
                      "milestone_id": {"$ref": "#/$defs/semanticId"},
                      "kind": {"enum": ["HARD_REQUIREMENT", "DERIVED_CHECKPOINT", "OPTIONAL_CHECKPOINT", "CONSTRAINT", "TERMINAL_REQUIREMENT"]},
                      "predicate_kind": {"enum": ["INSTRUCTION_REQUIREMENT", "GUI_STATE", "COMPLETED_TRANSITION", "USER_VISIBLE_RESULT", "DERIVED_STATE", "UNKNOWN"]},
                      "state_description": {"type": "string", "minLength": 1, "maxLength": 2048},
                      "instruction_span_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/semanticId"}]}
                    }
                  },
                  "graphRef": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["ref_kind", "ref_id"],
                    "properties": {
                      "ref_kind": {"enum": ["MILESTONE", "GATE"]},
                      "ref_id": {"$ref": "#/$defs/semanticId"}
                    }
                  },
                  "gate": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["gate_id", "operator", "children"],
                    "properties": {
                      "gate_id": {"$ref": "#/$defs/semanticId"},
                      "operator": {"enum": ["AND", "OR"]},
                      "children": {"type": "array", "minItems": 2, "maxItems": 128, "items": {"$ref": "#/$defs/graphRef"}}
                    }
                  },
                  "path": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path_id", "kind", "root"],
                    "properties": {
                      "path_id": {"$ref": "#/$defs/semanticId"},
                      "kind": {"enum": ["LEGAL_ALTERNATIVE", "OTHER_UNKNOWN"]},
                      "root": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/graphRef"}]}
                    }
                  }
                }
              }
            }
          }
        },
        "verbosity": {"const": "low"}
      }
    },
    "trackTextConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "verbosity"],
      "properties": {
        "format": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "strict", "schema"],
          "properties": {
            "type": {"const": "json_schema"},
            "name": {"const": "r24_live_rubric_track_v1"},
            "strict": {"const": true},
            "schema": {
              "const": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "$id": "https://agentsentinel.local/schemas/r2_4/rubric_track_output.v1.schema.json",
                "title": "R2.4 Live Rubric Track Output v1",
                "type": "object",
                "additionalProperties": false,
                "required": ["proposal_status", "milestone_states"],
                "properties": {
                  "proposal_status": {"enum": ["COMPLETE", "ABSTAIN"]},
                  "milestone_states": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/milestoneState"}}
                },
                "$defs": {
                  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "semanticId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
                  "evidenceRef": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["evidence_id", "payload_sha256", "relation"],
                    "properties": {
                      "evidence_id": {"$ref": "#/$defs/semanticId"},
                      "payload_sha256": {"$ref": "#/$defs/sha256"},
                      "relation": {"enum": ["SUPPORTS_STATE", "REFUTES_STATE", "OBSERVES_PROGRESS"]}
                    }
                  },
                  "milestoneState": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["milestone_id", "state", "evidence_refs", "reason_code"],
                    "properties": {
                      "milestone_id": {"$ref": "#/$defs/semanticId"},
                      "state": {"enum": ["pending", "in_progress", "satisfied", "violated", "unknown"]},
                      "evidence_refs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/evidenceRef"}},
                      "reason_code": {"enum": ["NOT_STARTED", "CURRENT_GUI_SUPPORT", "COMPLETED_TRANSITION_SUPPORT", "CURRENT_GUI_REFUTATION", "COMPLETED_TRANSITION_REFUTATION", "PROGRESS_OBSERVED", "PRESERVE_PRIOR_STATE", "AMBIGUOUS_GUI", "INSUFFICIENT_EVIDENCE", "CONFLICTING_EVIDENCE"]}
                    }
                  }
                }
              }
            }
          }
        },
        "verbosity": {"const": "low"}
      }
    },
    "providerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "instructions",
        "input",
        "reasoning",
        "text",
        "tools",
        "tool_choice",
        "parallel_tool_calls",
        "store",
        "stream",
        "truncation",
        "max_output_tokens"
      ],
      "properties": {
        "model": {"const": "gpt-5.6-sol"},
        "instructions": {
          "enum": [
            "You are the isolated MobileWorld task-rubric generator. Convert only the exact task instruction into a complete multi-path AND/OR milestone graph. For each instruction span, copy exact_text byte-for-byte and give only its zero-based Unicode char_start; the runtime derives all end and UTF-8 offsets. Every instruction span must be cited by exactly one instruction-bound milestone whose kind matches the span role, whose predicate_kind is INSTRUCTION_REQUIREMENT, and whose state_description exactly equals the span exact_text. Include every hard requirement, constraint, and terminal requirement without adding requirements. Every graph reference must resolve, every milestone and gate must be reachable, gates must be acyclic with at least two distinct children, and IDs must be unique. Include at least one LEGAL_ALTERNATIVE path with a non-null root and exactly one OTHER_UNKNOWN path with a null root. Use common_root only for requirements shared by every legal alternative. Do not infer factual truth, inspect history, recommend actions, or emit GUI action coordinates/tool calls. Return only JSON matching the supplied schema.",
            "You are the isolated MobileWorld rubric tracker. Evaluate every frozen milestone only from the supplied history-free packet and the current screenshot. Actor history, History IR, policy output, future events, benchmark checker results, and replay outcomes are absent and forbidden. Generic transition success, screenshot change, and free-form tool text are weak evidence and cannot alone establish satisfaction or violation. Cite exact evidence IDs and payload hashes. On ambiguity, conflict, or insufficiency use unknown; ABSTAIN requires every milestone unknown. Do not recommend or execute an action. Return only JSON matching the supplied schema."
          ]
        },
        "input": {
          "oneOf": [
            {"$ref": "#/$defs/generateInputMessages"},
            {"$ref": "#/$defs/trackInputMessages"}
          ]
        },
        "reasoning": {
          "type": "object",
          "additionalProperties": false,
          "required": ["effort"],
          "properties": {"effort": {"const": "low"}}
        },
        "text": {
          "oneOf": [
            {"$ref": "#/$defs/generateTextConfiguration"},
            {"$ref": "#/$defs/trackTextConfiguration"}
          ]
        },
        "tools": {"type": "array", "maxItems": 0},
        "tool_choice": {"const": "none"},
        "parallel_tool_calls": {"const": false},
        "store": {"const": false},
        "stream": {"const": false},
        "truncation": {"const": "disabled"},
        "max_output_tokens": {"const": 8192}
      }
    }
  }
}
