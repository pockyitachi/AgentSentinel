{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsentinel.local/schemas/r2_3/topology_comparison.v1.schema.json",
  "title": "R2.3 Rubric Topology Comparison v1",
  "description": "Comparison envelope for isolated history-free and optional joint non-independent runs. It records no deployment selection and never lets joint output replace isolated grounding.",
  "type": "object",
  "additionalProperties": false,
  "required": ["comparison_id", "logical_call_id", "isolated", "joint", "deployment_decision", "independent_grounding_source", "joint_may_replace_isolated", "deployment_topology_frozen", "schema_version"],
  "properties": {
    "comparison_id": {"$ref": "#/$defs/runtimeId"},
    "logical_call_id": {"$ref": "#/$defs/runtimeId"},
    "isolated": {"allOf": [{"$ref": "#/$defs/topologyRun"}, {"properties": {"topology": {"$ref": "#/$defs/isolatedTopology"}}}]},
    "joint": {"oneOf": [{"type": "null"}, {"allOf": [{"$ref": "#/$defs/topologyRun"}, {"properties": {"topology": {"$ref": "#/$defs/jointTopology"}}}]}]},
    "deployment_decision": {"const": "UNDECIDED_R2_4"},
    "independent_grounding_source": {"const": "ISOLATED_ONLY"},
    "joint_may_replace_isolated": {"const": false},
    "deployment_topology_frozen": {"const": false},
    "schema_version": {"const": "mobileworld.runtime.rubric-topology-comparison/v1"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtimeId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "safeCode": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z][A-Z0-9_]*$"},
    "isolatedTopology": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "independent_grounding_claim_eligible"],
      "properties": {"kind": {"const": "ISOLATED_HISTORY_FREE"}, "independent_grounding_claim_eligible": {"const": true}}
    },
    "jointTopology": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "independent_grounding_claim_eligible"],
      "properties": {"kind": {"const": "JOINT_NON_INDEPENDENT"}, "independent_grounding_claim_eligible": {"const": false}}
    },
    "topology": {
      "oneOf": [{"$ref": "#/$defs/isolatedTopology"}, {"$ref": "#/$defs/jointTopology"}]
    },
    "topologyRun": {
      "type": "object", "additionalProperties": false,
      "required": ["topology", "status", "rubric_input_sha256", "rubric_output_sha256", "rubric_receipt_sha256", "history_policy_input_sha256", "history_policy_output_sha256", "failure_code", "total_latency_ns"],
      "properties": {
        "topology": {"$ref": "#/$defs/topology"},
        "status": {"enum": ["NOT_RUN", "ADMITTED", "FALLBACK"]},
        "rubric_input_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "rubric_output_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "rubric_receipt_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "history_policy_input_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "history_policy_output_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "failure_code": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/safeCode"}]},
        "total_latency_ns": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {"if": {"properties": {"topology": {"properties": {"kind": {"const": "ISOLATED_HISTORY_FREE"}}, "required": ["kind"]}}, "required": ["topology"]}, "then": {"properties": {"history_policy_input_sha256": {"type": "null"}, "history_policy_output_sha256": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "NOT_RUN"}}, "required": ["status"]}, "then": {"properties": {"rubric_input_sha256": {"type": "null"}, "rubric_output_sha256": {"type": "null"}, "rubric_receipt_sha256": {"type": "null"}, "history_policy_input_sha256": {"type": "null"}, "history_policy_output_sha256": {"type": "null"}, "failure_code": {"type": "null"}, "total_latency_ns": {"const": 0}}}},
        {"if": {"properties": {"status": {"const": "ADMITTED"}}, "required": ["status"]}, "then": {"properties": {"rubric_input_sha256": {"$ref": "#/$defs/sha256"}, "rubric_output_sha256": {"$ref": "#/$defs/sha256"}, "rubric_receipt_sha256": {"$ref": "#/$defs/sha256"}, "failure_code": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "FALLBACK"}}, "required": ["status"]}, "then": {"properties": {"failure_code": {"$ref": "#/$defs/safeCode"}}}},
        {"if": {"properties": {"status": {"const": "ADMITTED"}, "topology": {"properties": {"kind": {"const": "JOINT_NON_INDEPENDENT"}}, "required": ["kind"]}}, "required": ["status", "topology"]}, "then": {"properties": {"history_policy_input_sha256": {"$ref": "#/$defs/sha256"}, "history_policy_output_sha256": {"$ref": "#/$defs/sha256"}}}}
      ]
    }
  }
}
