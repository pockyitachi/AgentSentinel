        "foreign_process_target_count": {"const": 0},
        "broad_process_signal_count": {"const": 0},
        "request_observation_count": {"const": 22},
        "network_observations": {"$ref": "#/$defs/contentRef"},
        "non_loopback_connection_count": {"const": 0},
        "socket_observation_count": {"const": 46},
        "socket_observations": {"$ref": "#/$defs/contentRef"},
        "non_loopback_inet_socket_count": {"const": 0},
        "credential_read_count": {"const": 0},
        "credential_scan_count": {"const": 24},
        "credential_scan_receipts": {
          "type": "array", "minItems": 24, "maxItems": 24,
          "items": {"$ref": "#/$defs/contentRef"}
        },
        "owned_command_receipt_count": {"type": "integer", "minimum": 0},
        "owned_command_receipts": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/contentRef"}
        },
        "network_namespace": {"$ref": "#/$defs/contentRef"},
        "runtime_scratch_pre_receipts": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/contentRef"}
        },
        "runtime_scratch_post_receipts": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/contentRef"}
        },
        "launcher_scratch_post": {"$ref": "#/$defs/contentRef"},
        "runtime_tree_post": {"$ref": "#/$defs/contentRef"},
        "stage1_preexec": {
          "oneOf": [{"$ref": "#/$defs/contentRef"}, {"type": "null"}]
        },
        "stage2_preimport": {
          "oneOf": [{"$ref": "#/$defs/contentRef"}, {"type": "null"}]
        },
        "client_environment": {"$ref": "#/$defs/contentRef"},
        "server_environment_receipts": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": {"$ref": "#/$defs/contentRef"}
        },
        "runtime_scratch_preserved_for_audit": {"const": true},
        "inet_inet6_external_network_mechanically_unavailable": {"const": true},
        "server_log_capture_complete": {"const": true},
        "generated_action_execution_count": {"const": 0},
        "mobileworld_action_count": {"const": 0},
        "replay_count": {"const": 0},
        "backend_restore_count": {"const": 0},
        "response_feedback_count": {"const": 0}
      }
    },
    "failLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_target_pids", "signal_sent_pids",
        "signal_intent_count", "signal_sent_count", "signal_trace",
        "recorded_launch_tree_pids", "foreign_process_target_count",
        "broad_process_signal_count", "request_observation_count",
        "network_observations", "non_loopback_connection_count",
        "socket_observation_count", "socket_observations",
        "non_loopback_inet_socket_count", "credential_read_count",
        "credential_scan_count", "credential_scan_receipts",
        "owned_command_receipt_count", "owned_command_receipts",
        "network_namespace", "runtime_scratch_pre_receipts",
        "runtime_scratch_post_receipts", "launcher_scratch_post",
        "runtime_tree_post", "stage1_preexec", "stage2_preimport",
        "client_environment", "server_environment_receipts",
        "runtime_scratch_preserved_for_audit",
        "inet_inet6_external_network_mechanically_unavailable",
        "server_log_capture_complete", "attempt_receipt_closure_proven",
        "snapshot_closure_proven", "scratch_closure_proven",
        "generated_action_execution_count", "mobileworld_action_count",
        "replay_count", "backend_restore_count", "response_feedback_count"
      ],
      "properties": {
        "signal_target_pids": {"$ref": "#/$defs/pidList"},
        "signal_sent_pids": {"$ref": "#/$defs/pidList"},
        "signal_intent_count": {"type": "integer", "minimum": 0},
        "signal_sent_count": {"type": "integer", "minimum": 0},
        "signal_trace": {"$ref": "#/$defs/contentRef"},
        "recorded_launch_tree_pids": {"$ref": "#/$defs/pidList"},
        "foreign_process_target_count": {"const": 0},
        "broad_process_signal_count": {"const": 0},
        "request_observation_count": {"type": "integer", "minimum": 0},
        "network_observations": {"$ref": "#/$defs/contentRef"},
        "non_loopback_connection_count": {"const": 0},
        "socket_observation_count": {"type": "integer", "minimum": 0},
        "socket_observations": {"$ref": "#/$defs/contentRef"},
        "non_loopback_inet_socket_count": {"const": 0},
        "credential_read_count": {"const": 0},
        "credential_scan_count": {"type": "integer", "minimum": 0},
        "credential_scan_receipts": {
          "type": "array",
          "items": {"$ref": "#/$defs/contentRef"}
        },
        "owned_command_receipt_count": {"type": "integer", "minimum": 0},
        "owned_command_receipts": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/contentRef"}
        },
        "network_namespace": {
          "oneOf": [{"$ref": "#/$defs/contentRef"}, {"type": "null"}]
        },
        "runtime_scratch_pre_receipts": {
          "type": "array", "maxItems": 2,
          "items": {"$ref": "#/$defs/contentRef"}
        },
        "runtime_scratch_post_receipts": {
          "type": "array", "maxItems": 2,
          "items": {"$ref": "#/$defs/contentRef"}
        },
        "launcher_scratch_post": {
          "oneOf": [{"$ref": "#/$defs/contentRef"}, {"type": "null"}]
        },
        "runtime_tree_post": {
          "oneOf": [{"$ref": "#/$defs/contentRef"}, {"type": "null"}]
        },
        "stage1_preexec": {
          "oneOf": [{"$ref": "#/$defs/contentRef"}, {"type": "null"}]
        },
        "stage2_preimport": {
          "oneOf": [{"$ref": "#/$defs/contentRef"}, {"type": "null"}]
        },
        "client_environment": {
          "oneOf": [{"$ref": "#/$defs/contentRef"}, {"type": "null"}]
        },
        "server_environment_receipts": {
          "type": "array", "maxItems": 2, "uniqueItems": true,
          "items": {"$ref": "#/$defs/contentRef"}
        },
        "runtime_scratch_preserved_for_audit": {"const": true},
        "inet_inet6_external_network_mechanically_unavailable": {"type": "boolean"},
        "server_log_capture_complete": {"type": "boolean"},
        "attempt_receipt_closure_proven": {"type": "boolean"},
        "snapshot_closure_proven": {"type": "boolean"},
        "scratch_closure_proven": {"type": "boolean"},
        "generated_action_execution_count": {"const": 0},
        "mobileworld_action_count": {"const": 0},
        "replay_count": {"const": 0},
        "backend_restore_count": {"const": 0},
        "response_feedback_count": {"const": 0}
      }
    }
