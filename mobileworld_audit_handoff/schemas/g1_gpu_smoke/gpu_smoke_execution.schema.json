    {
      "required": [
        "gpu_preflight", "gpu_postflight", "network_namespace",
        "launcher_scratch_post", "runtime_tree_post", "client_environment"
      ],
      "properties": {
        "status": {"const": "PASS"},
        "logical_call_count": {"const": 22},
        "physical_http_request_count": {"const": 22},
        "lifecycle_receipts": {"minItems": 2, "maxItems": 2},
        "call_receipts": {"minItems": 22, "maxItems": 22},
        "snapshot_pre_receipts": {"minItems": 2, "maxItems": 2},
        "snapshot_post_receipts": {"minItems": 2, "maxItems": 2},
        "runtime_scratch_pre_receipts": {"minItems": 2, "maxItems": 2},
        "runtime_scratch_post_receipts": {"minItems": 2, "maxItems": 2},
        "server_environment_receipts": {"minItems": 2, "maxItems": 2},
        "network_namespace": {"$ref": "#/$defs/contentRef"},
        "launcher_scratch_post": {"$ref": "#/$defs/contentRef"},
        "runtime_tree_post": {"$ref": "#/$defs/contentRef"},
        "client_environment": {"$ref": "#/$defs/contentRef"},
        "evidence_closure_proven": {"const": true},
        "own_service_release_proven": {"const": true},
        "operation_ledger": {"$ref": "#/$defs/passLedger"}
      },
      "not": {
        "anyOf": [
          {"required": ["error_code"]},
          {"required": ["error_json_path"]}
        ]
      }
    },
    {
      "required": ["error_code", "error_json_path", "error_detail"],
      "properties": {
        "status": {"const": "FAIL"},
        "operation_ledger": {"$ref": "#/$defs/failLedger"}
      },
      "not": {
        "anyOf": [
          {"required": ["gpu_preflight"]},
          {"required": ["gpu_postflight"]}
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "pidList": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "byte_count", "media_type"],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^objects/sha256/[0-9a-f]{2}/[0-9a-f]{64}$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1}
      }
    },
    "passLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
