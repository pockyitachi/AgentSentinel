    "toctou_free_model_binding_proven": {"const": false},
    "formal_runtime_immutability_proven": {"const": false},
    "toctou_free_runtime_binding_proven": {"const": false},
    "native_dt_needed_dependency_closure_proven": {"const": false},
    "generated_action_executed": {"const": false},
    "replay_executed": {"const": false},
    "evidence_closure_proven": {"type": "boolean"},
    "own_service_release_proven": {"type": "boolean"},
    "receipt_subject_sha256": {"$ref": "#/$defs/sha256"}
