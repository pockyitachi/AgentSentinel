{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsentinel.local/schemas/g1_gpu_smoke/gpu_smoke_server_environment.schema.json",
  "title": "G1 D-034 closed server environment receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "model_id", "model_scratch_root",
    "environment", "environment_keys", "environment_sha256",
    "python_child_import", "closed_allowlist", "ambient_environment_inherited",
    "credential_field_count"
  ],
  "properties": {
    "schema_version": {"const": "mobileworld.g1.gpu-live-smoke-server-environment/v2"},
    "run_id": {"$ref": "#/$defs/id"},
    "model_id": {"enum": ["qwen3vl_8b", "mai_ui_8b"]},
    "model_scratch_root": {"$ref": "#/$defs/absolutePath"},
    "environment": {"$ref": "#/$defs/serverEnvironment"},
    "environment_keys": {
      "const": [
        "CUDA_VISIBLE_DEVICES", "DO_NOT_TRACK", "GLOO_SOCKET_IFNAME",
        "HF_DATASETS_OFFLINE", "HF_HOME", "HF_HUB_DISABLE_TELEMETRY",
        "HF_HUB_OFFLINE", "HOME", "LANG", "LC_ALL", "LD_LIBRARY_PATH",
        "NCCL_SOCKET_IFNAME", "NO_PROXY", "PATH", "PYTHONDONTWRITEBYTECODE",
        "PYTHONNOUSERSITE", "PYTHONPATH", "PYTHONSAFEPATH", "TMPDIR",
        "TORCH_HOME", "TRANSFORMERS_OFFLINE", "TRITON_CACHE_DIR",
        "VLLM_CACHE_ROOT", "VLLM_HOST_IP", "VLLM_NO_USAGE_STATS",
        "VLLM_USE_MODELSCOPE", "XDG_CACHE_HOME", "no_proxy"
      ]
    },
    "environment_sha256": {"$ref": "#/$defs/sha256"},
    "python_child_import": {"$ref": "#/$defs/pythonChildImport"},
    "closed_allowlist": {"const": true},
    "ambient_environment_inherited": {"const": false},
    "credential_field_count": {"const": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "absolutePath": {
      "type": "string",
      "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "serverSitePackagesPath": {
      "allOf": [
        {"$ref": "#/$defs/absolutePath"},
        {"pattern": "/site-packages/server$"},
        {"not": {"pattern": ":"}}
      ]
    },
    "serverEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PATH", "CUDA_VISIBLE_DEVICES", "LD_LIBRARY_PATH", "HF_HUB_OFFLINE",
        "HF_HUB_DISABLE_TELEMETRY", "TRANSFORMERS_OFFLINE",
        "HF_DATASETS_OFFLINE", "VLLM_USE_MODELSCOPE", "VLLM_NO_USAGE_STATS",
        "DO_NOT_TRACK", "NO_PROXY", "no_proxy", "PYTHONNOUSERSITE",
        "PYTHONPATH", "PYTHONSAFEPATH", "PYTHONDONTWRITEBYTECODE", "LC_ALL",
        "LANG", "VLLM_HOST_IP", "NCCL_SOCKET_IFNAME", "GLOO_SOCKET_IFNAME",
        "HOME", "HF_HOME", "XDG_CACHE_HOME", "TORCH_HOME",
        "TRITON_CACHE_DIR", "VLLM_CACHE_ROOT", "TMPDIR"
      ],
      "properties": {
        "PATH": {"const": "/usr/bin:/bin"},
        "CUDA_VISIBLE_DEVICES": {"const": "GPU-991ac45f-e9e9-1c25-590c-fb49ca752965"},
        "LD_LIBRARY_PATH": {"const": ""},
        "HF_HUB_OFFLINE": {"const": "1"},
        "HF_HUB_DISABLE_TELEMETRY": {"const": "1"},
        "TRANSFORMERS_OFFLINE": {"const": "1"},
        "HF_DATASETS_OFFLINE": {"const": "1"},
        "VLLM_USE_MODELSCOPE": {"const": "False"},
        "VLLM_NO_USAGE_STATS": {"const": "1"},
        "DO_NOT_TRACK": {"const": "1"},
        "NO_PROXY": {"const": "127.0.0.1,localhost"},
        "no_proxy": {"const": "127.0.0.1,localhost"},
        "PYTHONNOUSERSITE": {"const": "1"},
        "PYTHONPATH": {"$ref": "#/$defs/serverSitePackagesPath"},
        "PYTHONSAFEPATH": {"const": "1"},
        "PYTHONDONTWRITEBYTECODE": {"const": "1"},
        "LC_ALL": {"const": "C.UTF-8"},
        "LANG": {"const": "C.UTF-8"},
        "VLLM_HOST_IP": {"const": "127.0.0.1"},
        "NCCL_SOCKET_IFNAME": {"const": "lo"},
        "GLOO_SOCKET_IFNAME": {"const": "lo"},
        "HOME": {"$ref": "#/$defs/absolutePath"},
        "HF_HOME": {"$ref": "#/$defs/absolutePath"},
        "XDG_CACHE_HOME": {"$ref": "#/$defs/absolutePath"},
        "TORCH_HOME": {"$ref": "#/$defs/absolutePath"},
        "TRITON_CACHE_DIR": {"$ref": "#/$defs/absolutePath"},
        "VLLM_CACHE_ROOT": {"$ref": "#/$defs/absolutePath"},
        "TMPDIR": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "startupRootCensus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "exists", "top_level_entry_count", "top_level_names_sha256",
        "forbidden_customization_present_count", "top_level_pth_present_count"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "exists": {"type": "boolean"},
        "top_level_entry_count": {"type": "integer", "minimum": 0},
        "top_level_names_sha256": {"$ref": "#/$defs/sha256"},
        "forbidden_customization_present_count": {"const": 0},
        "top_level_pth_present_count": {"const": 0}
      }
    },
    "startupPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "pythonpath", "pythonpath_authority_match",
        "pythonpath_single_absolute_resolved_entry", "python_safe_path_environment",
        "python_dont_write_bytecode_environment", "python_no_user_site_environment",
        "startup_roots", "required_existing_startup_roots", "startup_root_censuses",
        "default_site_packages_root_exists", "forbidden_customization_name_prefixes",
        "forbidden_customization_present_count", "top_level_pth_present_count",
        "python_stdlib_zip_path", "python_stdlib_zip_absent",
        "sealed_runtime_tree_forbidden_bytecode_or_pth_count",
        "pinned_nofollow_startup_root_census"
      ],
      "properties": {
        "schema_version": {"const": "mobileworld.g1.gpu-live-smoke-server-python-startup-policy/v1"},
        "pythonpath": {"$ref": "#/$defs/serverSitePackagesPath"},
        "pythonpath_authority_match": {"const": true},
        "pythonpath_single_absolute_resolved_entry": {"const": true},
        "python_safe_path_environment": {"const": "1"},
        "python_dont_write_bytecode_environment": {"const": "1"},
        "python_no_user_site_environment": {"const": "1"},
        "startup_roots": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "prefixItems": [
            {"$ref": "#/$defs/serverSitePackagesPath"},
            {"$ref": "#/$defs/absolutePath"},
            {"$ref": "#/$defs/absolutePath"},
            {"$ref": "#/$defs/absolutePath"}
          ],
          "items": false
        },
        "required_existing_startup_roots": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {"$ref": "#/$defs/absolutePath"}
        },
        "startup_root_censuses": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {"$ref": "#/$defs/startupRootCensus"}
        },
        "default_site_packages_root_exists": {"type": "boolean"},
        "forbidden_customization_name_prefixes": {"const": ["sitecustomize", "usercustomize"]},
        "forbidden_customization_present_count": {"const": 0},
        "top_level_pth_present_count": {"const": 0},
        "python_stdlib_zip_path": {
          "allOf": [
            {"$ref": "#/$defs/absolutePath"},
            {"pattern": "/lib/python312\\.zip$"}
          ]
        },
        "python_stdlib_zip_absent": {"const": true},
        "sealed_runtime_tree_forbidden_bytecode_or_pth_count": {"const": 0},
        "pinned_nofollow_startup_root_census": {"const": true}
      }
    },
    "childObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cwd_or_empty_path_present", "dont_write_bytecode", "no_user_site",
        "safe_path", "site_module_loaded", "sys_path", "vllm_module_loaded"
      ],
      "properties": {
        "cwd_or_empty_path_present": {"const": false},
        "dont_write_bytecode": {"const": true},
        "no_user_site": {"const": true},
        "safe_path": {"const": true},
        "site_module_loaded": {"const": true},
        "sys_path": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "prefixItems": [
            {"$ref": "#/$defs/serverSitePackagesPath"},
            {"$ref": "#/$defs/absolutePath"},
            {"$ref": "#/$defs/absolutePath"},
            {"$ref": "#/$defs/absolutePath"}
          ],
          "items": false
        },
        "vllm_module_loaded": {"const": false}
      }
    },
    "pythonChildImport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "module", "relative_path", "path", "sha256",
        "byte_count", "expected_argv", "expected_argv_sha256",
        "inherits_exact_server_environment", "subprocess_environment_override_present",
        "parent_isolated_mode_ignores_pythonpath", "startup_policy",
        "startup_policy_revalidated_after_child", "startup_policy_pre_sha256",
        "startup_policy_post_sha256", "startup_policy_pre_post_identical",
        "child_observation",
        "child_sys_path_sha256", "child_probe_imported_vllm",
        "child_probe_owned_command_sha256", "registry_subprocess_argv_source_ast_proven"
      ],
      "properties": {
        "schema_version": {"const": "mobileworld.g1.gpu-live-smoke-vllm-registry-subprocess/v1"},
        "module": {"const": "vllm.model_executor.models.registry"},
        "relative_path": {"const": "vllm/model_executor/models/registry.py"},
        "path": {
          "allOf": [
            {"$ref": "#/$defs/absolutePath"},
            {"pattern": "/site-packages/server/vllm/model_executor/models/registry\\.py$"}
          ]
        },
        "sha256": {"const": "66cc1cd3245239328c86af49dde46ac98bfefa3b5e52d038eb683c2d06076c25"},
        "byte_count": {"const": 43556},
        "expected_argv": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "prefixItems": [
            {
              "allOf": [
                {"$ref": "#/$defs/absolutePath"},
                {"pattern": "/bin/python3\\.12$"}
              ]
            },
            {"const": "-m"},
            {"const": "vllm.model_executor.models.registry"}
          ],
          "items": false
        },
        "expected_argv_sha256": {"$ref": "#/$defs/sha256"},
        "inherits_exact_server_environment": {"const": true},
        "subprocess_environment_override_present": {"const": false},
        "parent_isolated_mode_ignores_pythonpath": {"const": true},
        "startup_policy": {"$ref": "#/$defs/startupPolicy"},
        "startup_policy_revalidated_after_child": {"const": true},
        "startup_policy_pre_sha256": {"$ref": "#/$defs/sha256"},
        "startup_policy_post_sha256": {"$ref": "#/$defs/sha256"},
        "startup_policy_pre_post_identical": {"const": true},
        "child_observation": {"$ref": "#/$defs/childObservation"},
        "child_sys_path_sha256": {"$ref": "#/$defs/sha256"},
        "child_probe_imported_vllm": {"const": false},
        "child_probe_owned_command_sha256": {"$ref": "#/$defs/sha256"},
        "registry_subprocess_argv_source_ast_proven": {"const": true}
      }
    }
  }
}
