{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsentinel.local/schemas/g1_gpu_smoke/gpu_smoke_execution_locator.schema.json",
  "title": "G1 D-034 returned terminal receipt locator envelope",
  "description": "The in-memory/CLI return value: the exact stored execution receipt plus four discovery-only locator fields. The terminal content object itself validates against gpu_smoke_execution.schema.json and contains none of these locator fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "status", "manifest", "decision_id",
    "authority_id", "authority_sha256", "smoke_packet_sha256",
    "started_at_utc", "finished_at_utc", "model_order",
    "logical_call_count", "physical_http_request_count",
    "sdk_hidden_retry_count", "lifecycle_receipts", "call_receipts",
    "snapshot_pre_receipts", "snapshot_post_receipts", "network_namespace",
    "runtime_scratch_pre_receipts", "runtime_scratch_post_receipts",
    "launcher_scratch_post", "runtime_tree_post", "stage1_preexec",
    "stage2_preimport", "client_environment",
    "server_environment_receipts", "operation_ledger",
    "schema_validation",
    "formal_model_immutability_proven", "toctou_free_model_binding_proven",
    "formal_runtime_immutability_proven", "toctou_free_runtime_binding_proven",
    "native_dt_needed_dependency_closure_proven",
    "generated_action_executed", "replay_executed",
    "evidence_closure_proven", "own_service_release_proven",
    "receipt_subject_sha256",
    "terminal_receipt", "run_relative_path", "terminal_file", "manifest_file"
  ],
  "properties": {
    "schema_version": {"$ref": "gpu_smoke_execution.schema.json#/properties/schema_version"},
    "run_id": {"$ref": "gpu_smoke_execution.schema.json#/properties/run_id"},
    "status": {"$ref": "gpu_smoke_execution.schema.json#/properties/status"},
    "manifest": {"$ref": "gpu_smoke_execution.schema.json#/properties/manifest"},
    "decision_id": {"$ref": "gpu_smoke_execution.schema.json#/properties/decision_id"},
    "authority_id": {"$ref": "gpu_smoke_execution.schema.json#/properties/authority_id"},
    "authority_sha256": {"$ref": "gpu_smoke_execution.schema.json#/properties/authority_sha256"},
    "smoke_packet_sha256": {"$ref": "gpu_smoke_execution.schema.json#/properties/smoke_packet_sha256"},
    "started_at_utc": {"$ref": "gpu_smoke_execution.schema.json#/properties/started_at_utc"},
    "finished_at_utc": {"$ref": "gpu_smoke_execution.schema.json#/properties/finished_at_utc"},
    "model_order": {"$ref": "gpu_smoke_execution.schema.json#/properties/model_order"},
    "logical_call_count": {"$ref": "gpu_smoke_execution.schema.json#/properties/logical_call_count"},
    "physical_http_request_count": {"$ref": "gpu_smoke_execution.schema.json#/properties/physical_http_request_count"},
    "sdk_hidden_retry_count": {"$ref": "gpu_smoke_execution.schema.json#/properties/sdk_hidden_retry_count"},
    "lifecycle_receipts": {"$ref": "gpu_smoke_execution.schema.json#/properties/lifecycle_receipts"},
    "call_receipts": {"$ref": "gpu_smoke_execution.schema.json#/properties/call_receipts"},
    "snapshot_pre_receipts": {"$ref": "gpu_smoke_execution.schema.json#/properties/snapshot_pre_receipts"},
    "snapshot_post_receipts": {"$ref": "gpu_smoke_execution.schema.json#/properties/snapshot_post_receipts"},
    "network_namespace": {"$ref": "gpu_smoke_execution.schema.json#/properties/network_namespace"},
    "runtime_scratch_pre_receipts": {"$ref": "gpu_smoke_execution.schema.json#/properties/runtime_scratch_pre_receipts"},
    "runtime_scratch_post_receipts": {"$ref": "gpu_smoke_execution.schema.json#/properties/runtime_scratch_post_receipts"},
    "launcher_scratch_post": {"$ref": "gpu_smoke_execution.schema.json#/properties/launcher_scratch_post"},
    "runtime_tree_post": {"$ref": "gpu_smoke_execution.schema.json#/properties/runtime_tree_post"},
    "stage1_preexec": {"$ref": "gpu_smoke_execution.schema.json#/properties/stage1_preexec"},
    "stage2_preimport": {"$ref": "gpu_smoke_execution.schema.json#/properties/stage2_preimport"},
    "client_environment": {"$ref": "gpu_smoke_execution.schema.json#/properties/client_environment"},
    "server_environment_receipts": {"$ref": "gpu_smoke_execution.schema.json#/properties/server_environment_receipts"},
    "gpu_preflight": {"$ref": "gpu_smoke_execution.schema.json#/properties/gpu_preflight"},
    "gpu_postflight": {"$ref": "gpu_smoke_execution.schema.json#/properties/gpu_postflight"},
    "error_code": {"$ref": "gpu_smoke_execution.schema.json#/properties/error_code"},
    "error_json_path": {"$ref": "gpu_smoke_execution.schema.json#/properties/error_json_path"},
    "error_detail": {"$ref": "gpu_smoke_execution.schema.json#/properties/error_detail"},
    "operation_ledger": {"$ref": "gpu_smoke_execution.schema.json#/properties/operation_ledger"},
    "schema_validation": {"$ref": "gpu_smoke_execution.schema.json#/properties/schema_validation"},
    "formal_model_immutability_proven": {"$ref": "gpu_smoke_execution.schema.json#/properties/formal_model_immutability_proven"},
    "toctou_free_model_binding_proven": {"$ref": "gpu_smoke_execution.schema.json#/properties/toctou_free_model_binding_proven"},
    "formal_runtime_immutability_proven": {"$ref": "gpu_smoke_execution.schema.json#/properties/formal_runtime_immutability_proven"},
    "toctou_free_runtime_binding_proven": {"$ref": "gpu_smoke_execution.schema.json#/properties/toctou_free_runtime_binding_proven"},
    "native_dt_needed_dependency_closure_proven": {"$ref": "gpu_smoke_execution.schema.json#/properties/native_dt_needed_dependency_closure_proven"},
    "generated_action_executed": {"$ref": "gpu_smoke_execution.schema.json#/properties/generated_action_executed"},
    "replay_executed": {"$ref": "gpu_smoke_execution.schema.json#/properties/replay_executed"},
    "evidence_closure_proven": {"$ref": "gpu_smoke_execution.schema.json#/properties/evidence_closure_proven"},
    "own_service_release_proven": {"$ref": "gpu_smoke_execution.schema.json#/properties/own_service_release_proven"},
    "receipt_subject_sha256": {"$ref": "gpu_smoke_execution.schema.json#/properties/receipt_subject_sha256"},
    "terminal_receipt": {
      "$ref": "gpu_smoke_execution.schema.json#/$defs/contentRef"
    },
    "run_relative_path": {
      "type": "string",
      "pattern": "^runs/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "terminal_file": {"type": "string", "pattern": "^terminal-[0-9a-f]{64}\\.json$"},
    "manifest_file": {"type": "string", "pattern": "^manifest-[0-9a-f]{64}\\.json$"}
  },
  "oneOf": [
    {"$ref": "gpu_smoke_execution.schema.json#/oneOf/0"},
    {"$ref": "gpu_smoke_execution.schema.json#/oneOf/1"}
  ]
}
