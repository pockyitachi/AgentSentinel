{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsentinel.local/schemas/g1_gpu_smoke/gpu_smoke_call.schema.json",
  "title": "G1 D-034 per-call GPU live-smoke receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "call_id", "ordinal", "model_id", "phase",
    "seed", "repeat_index", "arm", "status", "application_request",
    "transmitted_request", "raw_response", "physical_request_count",
    "sdk_hidden_retry_count", "host_parser", "response_feedback_used",
    "generated_action_executed"
  ],
  "properties": {
    "schema_version": {"const": "mobileworld.g1.gpu-live-smoke-call/v1"},
    "run_id": {"$ref": "#/$defs/id"},
    "call_id": {"enum": [
      "g14-qwen-s1729-r1", "g14-qwen-s1729-r2",
      "g14-qwen-s2718-r1", "g14-qwen-s2718-r2",
      "g14-qwen-s31415-r1", "g14-qwen-s31415-r2",
      "g15-qwen-original-s1729", "g15-qwen-mask-s1729",
      "g15-qwen-mask-correction-s1729", "g15-qwen-oracle-clean-s1729",
      "g15-qwen-sham-benign-edit-s1729",
      "g14-mai-s1729-r1", "g14-mai-s1729-r2",
      "g14-mai-s2718-r1", "g14-mai-s2718-r2",
      "g14-mai-s31415-r1", "g14-mai-s31415-r2",
      "g15-mai-original-s1729", "g15-mai-mask-s1729",
      "g15-mai-mask-correction-s1729", "g15-mai-oracle-clean-s1729",
      "g15-mai-sham-benign-edit-s1729"
    ]},
    "ordinal": {"type": "integer", "minimum": 1, "maximum": 22},
    "model_id": {"enum": ["qwen3vl_8b", "mai_ui_8b"]},
    "phase": {"enum": ["G1_4_CANARY", "G1_5_CODEC"]},
    "seed": {"enum": [1729, 2718, 31415]},
    "repeat_index": {"type": ["integer", "null"], "minimum": 1, "maximum": 2},
    "arm": {
      "oneOf": [
        {"enum": ["ORIGINAL", "MASK", "MASK_CORRECTION", "ORACLE_CLEAN", "SHAM_BENIGN_EDIT"]},
        {"type": "null"}
      ]
    },
    "status": {"enum": ["PASS", "FAIL"]},
    "failure_stage": {"enum": ["PRE_RESPONSE", "POST_RESPONSE"]},
    "application_request": {"$ref": "#/$defs/contentRef"},
    "transmitted_request": {"$ref": "#/$defs/contentRef"},
    "render_evidence": {"type": ["object", "null"]},
    "raw_response": {
      "oneOf": [{"$ref": "#/$defs/contentRef"}, {"type": "null"}]
    },
    "response": {"type": "object"},
    "application_visible_attempt_count": {"type": ["integer", "null"], "minimum": 1, "maximum": 1},
    "physical_request_count": {"type": ["integer", "null"], "minimum": 0},
    "physical_request_count_upper_bound": {
      "oneOf": [{"const": 1}, {"type": "null"}]
    },
    "sdk_hidden_retry_count": {"const": 0},
    "error_code": {
      "type": "string",
      "pattern": "^GPU_SMOKE_[A-Z0-9_]+$",
      "description": "Production values must also validate against gpu_smoke_error.schema.json."
    },
    "host_parser": {"type": ["object", "null"]},
    "independent_client_state": {"const": true},
    "response_feedback_used": {"const": false},
    "generated_action_executed": {"const": false}
  },
  "oneOf": [
    {
      "required": ["render_evidence", "response", "independent_client_state"],
      "properties": {
        "status": {"const": "PASS"},
        "raw_response": {"$ref": "#/$defs/contentRef"},
        "physical_request_count": {"const": 1},
        "host_parser": {"type": "object"}
      },
      "not": {
        "anyOf": [
          {"required": ["failure_stage"]},
          {"required": ["application_visible_attempt_count"]},
          {"required": ["physical_request_count_upper_bound"]},
          {"required": ["error_code"]}
        ]
      }
    },
    {
      "properties": {"status": {"const": "FAIL"}},
      "oneOf": [
        {
          "required": [
            "failure_stage", "application_visible_attempt_count",
            "physical_request_count_upper_bound", "error_code"
          ],
          "properties": {
            "failure_stage": {"const": "PRE_RESPONSE"},
            "raw_response": {"type": "null"},
            "host_parser": {"type": "null"}
          },
          "not": {
            "anyOf": [
              {"required": ["render_evidence"]},
              {"required": ["response"]},
              {"required": ["independent_client_state"]}
            ]
          }
        },
        {
          "required": [
            "failure_stage", "response", "application_visible_attempt_count",
            "physical_request_count_upper_bound", "error_code",
            "independent_client_state"
          ],
          "properties": {
            "failure_stage": {"const": "POST_RESPONSE"},
            "raw_response": {"$ref": "#/$defs/contentRef"},
            "response": {"type": "object"},
            "physical_request_count_upper_bound": {"const": 1},
            "host_parser": {"type": ["object", "null"]},
            "independent_client_state": {"const": true}
          },
          "not": {"required": ["render_evidence"]}
        }
      ]
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "byte_count", "media_type"],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^objects/sha256/[0-9a-f]{2}/[0-9a-f]{64}$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1}
      }
    }
  }
}
