{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsentinel.local/schemas/g1_5/host_coordinate_binding.schema.json",
  "title": "G1.5 Host Coordinate / No-Tokenizer Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "tokenizer_required",
    "tokenizer_id",
    "tokenizer_revision",
    "tokenizer_artifact_sha256",
    "text_normalization",
    "character_coordinates",
    "byte_coordinates",
    "container_coordinates",
    "fail_closed_on_normalization_or_coordinate_drift"
  ],
  "properties": {
    "schema_version": {
      "const": "mobileworld.g1.history-codec-host-coordinate-binding/v1"
    },
    "binding_id": {
      "const": "mobileworld.g1.host-json-unicode-utf8/no-tokenizer-v1"
    },
    "tokenizer_required": {"const": false},
    "tokenizer_id": {"const": "NONE"},
    "tokenizer_revision": {"const": "NONE"},
    "tokenizer_artifact_sha256": {"type": "null"},
    "text_normalization": {"const": "NONE"},
    "character_coordinates": {"const": "UNICODE_CODE_POINT_HALF_OPEN"},
    "byte_coordinates": {"const": "UTF8_HALF_OPEN"},
    "container_coordinates": {"const": "EXACT_JSON_PATH"},
    "fail_closed_on_normalization_or_coordinate_drift": {"const": true}
  }
}
